---
// Banco de pruebas de la ciudad: solo existe con `astro dev`, no se publica.
// Parámetros: ?nivel=alto|medio|bajo, ?ligero, ?reducido, ?encuadre=ancho|alto, ?dpr=2, ?apagon,
// ?encendida=slug, ?acercar=0.45, ?poster
// (?poster: sin panel ni movimiento; al acabar deja en window.poster las posiciones de los ventanales).
import '../../styles/global.css';
import { getCiudad } from '../../lib/ciudad';

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { ruta: 'ciudad' } }] : [];
}

const datos = await getCiudad('es');
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Ciudad · pruebas</title>
  </head>
  <body class="m-0 h-svh overflow-hidden bg-bosque-hondo">
    <canvas id="ciudad" class="block h-svh w-full touch-none" aria-hidden="true"></canvas>
    <output id="medidas" class="fixed top-2 right-2 rounded-md bg-bosque-hondo px-2 py-1 text-sm"></output>
    <script type="application/json" id="datos-ciudad" set:html={JSON.stringify(datos)} />
  </body>
</html>

<script>
  import { montarCiudad, type DatosVentana, type Encuadre, type Nivel } from '../../ciudad';

  const datos: DatosVentana[] = JSON.parse(document.getElementById('datos-ciudad')!.textContent!);
  const canvas = document.getElementById('ciudad') as HTMLCanvasElement;
  const medidas = document.getElementById('medidas')!;
  const params = new URLSearchParams(location.search);

  const poster = params.has('poster');
  if (poster) medidas.hidden = true;
  const estado = { nivel: '', fps: 0, primerFrame: 0, pasando: null as string | null, pulsado: null as string | null };
  const ciudad = await montarCiudad(canvas, datos, {
    nivel: (params.get('nivel') as Nivel | null) ?? undefined,
    reducido: poster || params.has('reducido'),
    encuadre: (params.get('encuadre') as Encuadre | null) ?? undefined,
    dpr: params.has('dpr') ? Number(params.get('dpr')) : undefined,
    apagon: params.has('apagon'),
    encendida: params.get('encendida') ?? undefined,
    alPrimerFrame: () => {
      estado.primerFrame = performance.now();
      // Posiciones relativas (0–1) de cada ventanal, para los enlaces del póster sin WebGL
      // También el escaparate (#apps), el estudio (#sobre-mi), el cartel del solar (#contacto) y el bajo comercial (#negocios)
      const ventanas = [...datos.map(({ slug }) => slug), '#apps', '#sobre-mi', '#contacto', '#negocios'].map((slug) => {
        const p = ciudad.enPantalla(slug)!;
        const r = ciudad.enPantalla(slug, 'rotulo')!;
        const relativo = (q: { x: number; y: number }) => ({ x: q.x / canvas.clientWidth, y: q.y / canvas.clientHeight });
        // Los rótulos del escaparate y del bajo comercial van encima del toldo, no en el centro del cristal
        return { slug, ...relativo(p), ...(slug === '#apps' || slug === '#negocios' ? { rx: relativo(r).x, ry: relativo(r).y } : {}) };
      });
      Object.assign(window, { poster: { ventanas } });
    },
    alPasar: (slug) => (estado.pasando = slug),
    alPulsar: async (slug) => {
      estado.pulsado = slug;
      await ciudad.volarA(slug);
      await new Promise((r) => setTimeout(r, 400));
      await ciudad.volverDe(slug);
    },
  });

  // FPS de los últimos 60 fotogramas, para el panel y para Playwright
  const marcas: number[] = [];
  const medir = (t: number) => {
    marcas.push(t);
    if (marcas.length > 61) marcas.shift();
    if (marcas.length > 1) estado.fps = Math.round((1000 * (marcas.length - 1)) / (t - marcas[0]));
    estado.nivel = ciudad.nivel;
    medidas.textContent = `${estado.nivel} · ${estado.fps} fps`;
    requestAnimationFrame(medir);
  };
  requestAnimationFrame(medir);
  // ?acercar=0.45&encendida=slug: la cámara a esa fracción del vuelo hacia el ventanal (Open Graph)
  if (params.has('acercar') && params.get('encendida')) ciudad.situarEn(params.get('encendida')!, Number(params.get('acercar')));
  Object.assign(window, { ciudad, estadoCiudad: estado });
</script>

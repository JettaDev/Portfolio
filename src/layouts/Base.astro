---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLang, useT, switchLangPath } from '../i18n/utils';
import { languages, type Lang } from '../i18n/ui';
// La misma fuente que importa global.css: precargarla evita el salto al cambiar de tipografía.
import fuente from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-opsz-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  /** Imagen Open Graph 1200×630 (ruta en public/); por defecto la del sitio */
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  /** La cabecera empieza transparente sobre el hero a pantalla completa (portada) */
  cabeceraSobreHero?: boolean;
}

const lang = getLang(Astro.url);
const t = useT(lang);
const { title, description = t('meta.description'), image = `/og/${lang}/index.png`, imageAlt = t('meta.title'), noindex = false, cabeceraSobreHero = false } = Astro.props;
const fullTitle = title ? `${title} · JettaDev` : t('meta.title');
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {(Object.keys(languages) as Lang[]).map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(switchLangPath(Astro.url, l), Astro.site)} />
    ))}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={fuente} as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <meta name="theme-color" content="#10291c" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <meta property="og:site_name" content="JettaDev" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <slot name="head" />
  </head>
  <body class="min-h-dvh flex flex-col">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-calendula focus:px-4 focus:py-2 focus:font-semibold focus:text-bosque-hondo"
    >
      {t('nav.skip')}
    </a>
    <Header sobreHero={cabeceraSobreHero} />
    <main id="contenido" class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      // Entrada escalonada: cada hijo de [data-reveal] recibe su orden y el bloque se marca al verse.
      // Con data-reveal="cada" (textos largos) cada hijo entra por su cuenta al llegar a él.
      const bloques = [...document.querySelectorAll<HTMLElement>('[data-reveal]')];
      const objetivos = bloques.flatMap((b) => {
        const hijos = [...b.children] as HTMLElement[];
        if (b.dataset.reveal === 'cada') return hijos;
        hijos.forEach((c, i) => c.style.setProperty('--i', String(i)));
        return [b];
      });
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entradas) => entradas.forEach((e) => e.isIntersecting && (e.target.classList.add('visto'), io.unobserve(e.target))),
          { rootMargin: '0px 0px -8% 0px' },
        );
        objetivos.forEach((o) => io.observe(o));
      } else objetivos.forEach((o) => o.classList.add('visto'));
    </script>
  </body>
</html>

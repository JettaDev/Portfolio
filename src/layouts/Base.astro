---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLang, useT, switchLangPath } from '../i18n/utils';
import { languages, type Lang } from '../i18n/ui';
// La misma fuente que importa global.css: precargarla evita el salto al cambiar de tipografía.
import fuente from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-opsz-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  /** Imagen Open Graph 1200×630 (ruta en public/); por defecto la del sitio */
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  /** La cabecera empieza transparente sobre el hero a pantalla completa (portada y 404) */
  cabeceraSobreHero?: boolean;
  /** Es la portada de la ciudad: al volver de una ficha, su ventana encoge hasta el edificio */
  portada?: boolean;
  /** Una sola pantalla, sin scroll ni pie (la portada) */
  pantallaCompleta?: boolean;
  /** La página tiene una ventana (#ventana-destino) a la que llega la que sale de la ciudad */
  ventanaDestino?: boolean;
}

const lang = getLang(Astro.url);
const t = useT(lang);
const { title, description = t('meta.description'), image = `/og/${lang}/index.png`, imageAlt = t('meta.title'), noindex = false, cabeceraSobreHero = false, portada = false, pantallaCompleta = false, ventanaDestino = false } = Astro.props;
const fullTitle = title ? `${title} · JettaDev` : t('meta.title');
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang={lang} data-portada={portada || undefined} class:list={[pantallaCompleta && 'h-dvh overflow-hidden']}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {(Object.keys(languages) as Lang[]).map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(switchLangPath(Astro.url, l), Astro.site)} />
    ))}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={fuente} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Antes del primer pintado: clase .js y la transición «la ventana sale» (src/lib/salida.ts):
      // si se llega desde la ciudad, la ventana de esta página recibe el nombre de la que sale de
      // la fachada; si se vuelve a la portada, su ventana en el póster recibe el de esta página.
      (() => {
        const html = document.documentElement;
        html.classList.add('js');
        try {
          const s = sessionStorage;
          const ruta = (p) => p.replace(/(.)\/$/, '$1');
          addEventListener('pagehide', () => s.setItem('ciudad:anterior', ruta(location.pathname)));
          // Volviendo a la ciudad (Atrás o el logo) desde la página a la que se llegó desde ella: su
          // ventana vuelve al edificio. Nada más vuela (el título no existe en la portada)
          addEventListener('pageswap', (e) => {
            const url = e.activation && e.viewTransition ? new URL(e.activation.entry.url) : null;
            const inicio = location.pathname.startsWith('/en/') ? '/en/' : '/';
            const desde = JSON.parse(s.getItem('ciudad:desde') || 'null');
            if (!url || url.pathname !== inicio || !desde || desde.href !== ruta(location.pathname)) return;
            document.querySelectorAll('.vt-titulo, [data-vt]').forEach((el) => el.style.setProperty('view-transition-name', 'none'));
            const ventana = document.querySelector('[data-ventana-destino]');
            if (ventana && ventana.getBoundingClientRect().bottom > 0) ventana.style.setProperty('view-transition-name', 'salida');
          });
          // Mientras dura una view transition, data-transicion (la ciudad espera a que acabe)
          addEventListener('pagereveal', (e) => {
            const vt = e.viewTransition;
            if (!vt) {
              delete html.dataset.llegada;
              return;
            }
            html.dataset.transicion = '';
            vt.finished.finally(() => {
              delete html.dataset.transicion;
              delete html.dataset.llegada;
            });
          });
          const llegada = s.getItem('ciudad:llegada');
          s.removeItem('ciudad:llegada');
          if (llegada && llegada === ruta(location.pathname)) html.dataset.llegada = '';
          if (html.hasAttribute('data-portada')) {
            const desde = JSON.parse(s.getItem('ciudad:desde') || 'null');
            s.removeItem('ciudad:desde');
            // De dónde se viene: lo escribe el pagehide de la página anterior o, si aún no ha llegado, el referrer
            const referrer = document.referrer ? ruta(new URL(document.referrer).pathname) : '';
            if (desde && (s.getItem('ciudad:anterior') === desde.href || referrer === desde.href) && !location.hash) {
              html.dataset.regreso = desde.slug;
              // Su sitio en el póster (el de los dos encuadres que se vea) recibe la ventana
              const id = JSON.stringify(desde.slug);
              const estilo = document.createElement('style');
              estilo.textContent = '.ventana-poster[data-id=' + id + '], [data-rotulo=' + id + ']:not([data-rotulo="#apps"]) { view-transition-name: salida; }';
              document.head.append(estilo);
            }
          }
        } catch {}
      })();
    </script>
    <meta name="theme-color" content="#10291c" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <meta property="og:site_name" content="JettaDev" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {/* La view transition espera a que esté la ventana de destino (está más abajo en el HTML) */}
    {ventanaDestino && <link rel="expect" href="#ventana-destino" blocking="render" />}
    {/* En la portada, los sitios del póster (adonde vuelve la ventana) */}
    {portada && <link rel="expect" href="#sitios-poster" blocking="render" />}
    <slot name="head" />
  </head>
  <body class:list={['flex flex-col', pantallaCompleta ? 'h-dvh overflow-hidden' : 'min-h-dvh']}>
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-calendula focus:px-4 focus:py-2 focus:font-semibold focus:text-bosque-hondo"
    >
      {t('nav.skip')}
    </a>
    <Header sobreHero={cabeceraSobreHero} />
    <main id="contenido" class="flex-1">
      <slot />
    </main>
    {!pantallaCompleta && <Footer />}
    <script>
      // Entrada escalonada: cada hijo de [data-reveal] recibe su orden y el bloque se marca al verse.
      // Con data-reveal="cada" (textos largos) cada hijo entra por su cuenta al llegar a él.
      const bloques = [...document.querySelectorAll<HTMLElement>('[data-reveal]')];
      const objetivos = bloques.flatMap((b) => {
        const hijos = [...b.children] as HTMLElement[];
        if (b.dataset.reveal === 'cada') return hijos;
        hijos.forEach((c, i) => c.style.setProperty('--i', String(i)));
        return [b];
      });
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entradas) => entradas.forEach((e) => e.isIntersecting && (e.target.classList.add('visto'), io.unobserve(e.target))),
          { rootMargin: '0px 0px -8% 0px' },
        );
        objetivos.forEach((o) => io.observe(o));
      } else objetivos.forEach((o) => o.classList.add('visto'));
    </script>
  </body>
</html>

---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLang, useT, switchLangPath } from '../i18n/utils';
import { languages, type Lang } from '../i18n/ui';
// La misma fuente que importa global.css: precargarla evita el salto al cambiar de tipografía.
import fuente from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-opsz-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  /** Imagen Open Graph 1200×630 (ruta en public/); por defecto la del sitio */
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  /** La cabecera empieza transparente sobre el hero a pantalla completa (portada y 404) */
  cabeceraSobreHero?: boolean;
  /** Es la portada de la ciudad: al volver de una ficha, el destello sale cubriendo */
  portada?: boolean;
  /** Una sola pantalla, sin scroll ni pie (la portada) */
  pantallaCompleta?: boolean;
  /** Sin cabecera (el juego tiene su propia interfaz) */
  sinCabecera?: boolean;
}

const lang = getLang(Astro.url);
const t = useT(lang);
const { title, description = t('meta.description'), image = `/og/${lang}/index.png`, imageAlt = t('meta.title'), noindex = false, cabeceraSobreHero = false, portada = false, pantallaCompleta = false, sinCabecera = false } = Astro.props;
const fullTitle = title ? `${title} · JettaDev` : t('meta.title');
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang={lang} data-portada={portada || undefined} class:list={[pantallaCompleta && 'h-dvh overflow-hidden']}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {(Object.keys(languages) as Lang[]).map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(switchLangPath(Astro.url, l), Astro.site)} />
    ))}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={fuente} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Antes del primer pintado: clase .js y, si se viene de la ciudad o se vuelve a ella, el
      // destello ya cubriendo la página (ver src/lib/destello.ts).
      (() => {
        const html = document.documentElement;
        html.classList.add('js');
        try {
          const s = sessionStorage;
          const ruta = (p) => p.replace(/(.)\/$/, '$1');
          addEventListener('pagehide', () => {
            s.setItem('ciudad:anterior', ruta(location.pathname));
            // Al volver a la ciudad, la capa crecerá desde la ventana de esta página
            const r = document.querySelector('[data-destello-destino]')?.getBoundingClientRect();
            const dentro = (v, max) => Math.round(Math.min(Math.max(v, 0), max));
            if (r) s.setItem('ciudad:origen', JSON.stringify({ x: dentro(r.left + r.width / 2, innerWidth), y: dentro(r.top + r.height / 2, innerHeight) }));
            else s.removeItem('ciudad:origen');
          });
          const origen = () => {
            const o = JSON.parse(s.getItem('ciudad:origen') || 'null') || { x: innerWidth / 2, y: innerHeight / 2 };
            html.style.setProperty('--destello-x', o.x + 'px');
            html.style.setProperty('--destello-y', o.y + 'px');
          };
          // Atrás con bfcache: este script no vuelve a ejecutarse, pero la capa también crece desde allí
          addEventListener('pageshow', (e) => e.persisted && html.hasAttribute('data-destello') && origen());
          // Volviendo a la ciudad (Atrás o el logo), la página que se deja se queda quieta mientras la
          // capa crece encima: su título y su ventana no deben irse con su nombre de view transition,
          // porque en la portada no existen y desaparecerían de la instantánea
          addEventListener('pageswap', (e) => {
            const url = e.activation && e.viewTransition ? new URL(e.activation.entry.url) : null;
            const inicio = location.pathname.startsWith('/en/') ? '/en/' : '/';
            const desde = JSON.parse(s.getItem('ciudad:desde') || 'null');
            if (!url || url.pathname !== inicio || !desde || desde.href !== ruta(location.pathname)) return;
            document.querySelectorAll('.vt-titulo, [data-vt]').forEach((el) => el.style.setProperty('view-transition-name', 'none'));
          });
          // Mientras dura la view transition de llegada, data-transicion (la ciudad espera a que acabe
          // para recoger la capa: si no, se recogería mientras la transición la hace crecer)
          addEventListener('pagereveal', (e) => {
            const vt = e.viewTransition;
            if (!vt) return;
            html.dataset.transicion = '';
            vt.finished.finally(() => delete html.dataset.transicion);
          });
          const llegada = s.getItem('ciudad:llegada');
          s.removeItem('ciudad:llegada');
          if (llegada && llegada === ruta(location.pathname)) html.dataset.destello = 'llegada';
          if (html.hasAttribute('data-portada')) {
            const desde = JSON.parse(s.getItem('ciudad:desde') || 'null');
            s.removeItem('ciudad:desde');
            if (desde && s.getItem('ciudad:anterior') === desde.href && !location.hash) {
              html.dataset.destello = 'regreso';
              html.dataset.regreso = desde.slug;
              origen();
            }
          }
        } catch {}
      })();
    </script>
    <meta name="theme-color" content="#10291c" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <meta property="og:site_name" content="JettaDev" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <slot name="head" />
  </head>
  <body class:list={['flex flex-col', pantallaCompleta ? 'h-dvh overflow-hidden' : 'min-h-dvh']}>
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-calendula focus:px-4 focus:py-2 focus:font-semibold focus:text-bosque-hondo"
    >
      {t('nav.skip')}
    </a>
    {!sinCabecera && <Header sobreHero={cabeceraSobreHero} />}
    <main id="contenido" class="flex-1">
      <slot />
    </main>
    {!pantallaCompleta && <Footer />}
    <div class="destello" aria-hidden="true" data-destello-capa></div>
    <script>
      // Llegada desde la ciudad: el destello se recoge sobre la ventana de la página (la portada de
      // la ficha, la primera app del catálogo, el titular de Sobre mí o de Contacto)
      import { centroDe, retirar } from '../lib/destello';
      // (salvo si la página lo recoge ella misma cuando está lista: el juego)
      if (document.documentElement.dataset.destello === 'llegada' && !document.querySelector('[data-destello-espera]')) retirar(centroDe(document.querySelector('[data-destello-destino]')));
    </script>
    <script>
      // Entrada escalonada: cada hijo de [data-reveal] recibe su orden y el bloque se marca al verse.
      // Con data-reveal="cada" (textos largos) cada hijo entra por su cuenta al llegar a él.
      const bloques = [...document.querySelectorAll<HTMLElement>('[data-reveal]')];
      const objetivos = bloques.flatMap((b) => {
        const hijos = [...b.children] as HTMLElement[];
        if (b.dataset.reveal === 'cada') return hijos;
        hijos.forEach((c, i) => c.style.setProperty('--i', String(i)));
        return [b];
      });
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entradas) => entradas.forEach((e) => e.isIntersecting && (e.target.classList.add('visto'), io.unobserve(e.target))),
          { rootMargin: '0px 0px -8% 0px' },
        );
        objetivos.forEach((o) => io.observe(o));
      } else objetivos.forEach((o) => o.classList.add('visto'));
    </script>
  </body>
</html>

---
// Webs para negocios locales: las cuatro demos de plantillas/ (servidas en /plantillas/, solo en español).
import { getLang, useT } from '../i18n/utils';

const lang = getLang(Astro.url);
const t = useT(lang);

// hue: un tono claro de la paleta de cada demo, solo para el subrayado al pasar por encima.
const demos = [
  { slug: 'restaurante', nombre: 'Mesón La Trébede', hue: '#e0806f' },
  { slug: 'peluqueria', nombre: 'Atelier Malva', hue: '#d7aed0' },
  { slug: 'autoescuela', nombre: 'Autoescuela Rotonda', hue: '#f5c400' },
  { slug: 'fisioterapia', nombre: 'Clínica Eje', hue: '#8fc7ae' },
] as const;
const nota = t('plantillas.note');
---

<section class="bg-musgo py-24 lg:py-36" aria-labelledby="t-plantillas">
  <div class="contenedor grid gap-12 lg:grid-cols-12 lg:gap-12">
    <div class="lg:col-span-5" data-reveal>
      <h2 id="t-plantillas" class="text-[clamp(2.25rem,4.5vw,3.5rem)] leading-none font-bold tracking-[-0.03em] text-balance">{t('plantillas.title')}</h2>
      <p class="mt-6 max-w-[44ch] text-xl text-pretty text-liquen">{t('plantillas.lead')}</p>
      {nota && <p class="mt-3 text-sm text-helecho">{nota}</p>}
      <a href="/plantillas/" class="boton boton-principal mt-8" hreflang="es">{t('plantillas.cta')}</a>
    </div>

    <ul class="grid gap-3 sm:grid-cols-2 lg:col-span-7" data-reveal>
      {demos.map((d) => (
        <li>
          <a href={`/plantillas/${d.slug}/`} hreflang="es" class="group flex h-full min-h-28 flex-col justify-end rounded-ventana bg-musgo-claro p-6 transition-colors hover:bg-corteza" style={`--hue:${d.hue}`}>
            <span class="text-2xl leading-tight font-bold tracking-[-0.02em] decoration-(--hue) decoration-[3px] underline-offset-[6px] group-hover:underline" translate="no">{d.nombre}</span>
            <span class="mt-1 text-liquen/80">{t(`plantillas.${d.slug}`)}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

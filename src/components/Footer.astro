---
import NewTab from './NewTab.astro';
import { getLang, useT } from '../i18n/utils';
import { site } from '../site';

const t = useT(getLang(Astro.url));
const year = new Date().getFullYear();
---

<footer class="bg-bosque-hondo">
  <div class="contenedor pt-16 pb-10">
    <!-- El nombre vuelve a todo el ancho como cierre; es decorativo (el texto real está abajo) -->
    <p
      class="text-[clamp(4rem,26vw,21.5rem)] leading-[0.8] font-bold tracking-[-0.05em] text-musgo-claro select-none [font-variation-settings:'opsz'_96] before:content-['JettaDev']"
      aria-hidden="true"
    ></p>
    <div class="mt-10 flex flex-col gap-4 text-helecho sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {t('footer.made')}</p>
      <ul class="flex gap-6">
        <li><a class="transition-colors hover:text-liquen" href={site.github} rel="me noopener" target="_blank">GitHub<NewTab /></a></li>
        {site.linkedin && <li><a class="transition-colors hover:text-liquen" href={site.linkedin} rel="me noopener" target="_blank">LinkedIn<NewTab /></a></li>}
        <li><a class="transition-colors hover:text-liquen" href={`mailto:${site.email}`}>Email</a></li>
      </ul>
    </div>
  </div>
</footer>

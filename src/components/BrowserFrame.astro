---
// Marco de navegador reutilizable para mostrar capturas de las apps.
interface Props {
  domain: string;
  hue?: string;
  class?: string;
  /** view-transition-name: la misma ventana en el listado y en el detalle se transforma de una a otra */
  name?: string;
}
const { domain, hue = '#7fe0a6', class: className, name } = Astro.props;
---

<div
  class:list={['overflow-hidden rounded-ventana border border-corteza bg-bosque-hondo shadow-[0_30px_80px_-30px_rgb(0_0_0/0.7)]', className]}
  style={`--hue:${hue}${name ? `; view-transition-name:${name}; view-transition-class:ventana` : ''}`}
  data-vt={name}
>
  <div class="flex items-center gap-3 border-b border-corteza/70 px-4 py-2.5">
    <span class="flex gap-1.5" aria-hidden="true">
      <span class="size-2.5 rounded-full bg-corteza"></span>
      <span class="size-2.5 rounded-full bg-corteza"></span>
      <span class="size-2.5 rounded-full bg-corteza"></span>
    </span>
    <span class="flex min-w-0 flex-1 items-center gap-2 rounded-md bg-musgo px-3 py-1 text-xs text-helecho">
      <span class="size-1.5 shrink-0 rounded-full bg-(--hue)" aria-hidden="true"></span>
      <span class="truncate">{domain}</span>
    </span>
  </div>
  <slot />
</div>

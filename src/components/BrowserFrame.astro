---
// Marco de navegador reutilizable para mostrar capturas de las apps.
interface Props {
  domain: string;
  hue?: string;
  class?: string;
  /** view-transition-name: la misma ventana en el listado y en el detalle se transforma de una a otra */
  name?: string;
  /** Dentro de un botón o enlace con su propio nombre: el dominio es decorativo y no debe contar como texto */
  decorativa?: boolean;
  /** Marco en el color de la app, como el ventanal de su edificio en la ciudad (forma parte de la ventana al transformarse) */
  marco?: boolean;
  /** Es la ventana a la que llega la que sale de la ciudad (src/lib/salida.ts) */
  destino?: boolean;
}
const { domain, hue = '#7fe0a6', class: className, name, decorativa = false, marco = false, destino = false } = Astro.props;
---

<div
  class:list={[marco ? 'rounded-[calc(var(--radius-ventana)+0.375rem)] bg-(--hue) p-1.5 sm:p-2' : 'overflow-hidden rounded-ventana bg-bosque-hondo', className]}
  style={`--hue:${hue}${name ? `; view-transition-name:${name}; view-transition-class:ventana` : ''}`}
  data-vt={name}
  id={destino ? 'ventana-destino' : undefined}
  data-ventana-destino={destino || undefined}
>
  <div class:list={marco ? 'overflow-hidden rounded-ventana bg-bosque-hondo' : 'contents'}>
    <div class="flex items-center gap-3 bg-musgo px-4 py-2.5">
      <span class="flex gap-1.5" aria-hidden="true">
        <span class="size-2.5 rounded-full bg-musgo-claro"></span>
        <span class="size-2.5 rounded-full bg-musgo-claro"></span>
        <span class="size-2.5 rounded-full bg-musgo-claro"></span>
      </span>
      <span class="flex min-w-0 flex-1 items-center gap-2 rounded-md bg-bosque-hondo/60 px-3 py-1 text-sm text-helecho">
        <span class="size-1.5 shrink-0 rounded-full bg-(--hue)" aria-hidden="true"></span>
        {decorativa ? (
          <span class="truncate before:content-[attr(data-dominio)]" data-dominio={domain} aria-hidden="true"></span>
        ) : (
          <span class="truncate" translate="no">{domain}</span>
        )}
      </span>
      <slot name="acciones" />
    </div>
    <slot />
  </div>
</div>

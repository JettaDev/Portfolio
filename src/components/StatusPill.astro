---
import { getLang, useT } from '../i18n/utils';

interface Props {
  status: 'live' | 'beta' | 'wip';
}
const { status } = Astro.props;
const t = useT(getLang(Astro.url));
const styles = {
  live: 'text-brote border-brote/40',
  beta: 'text-calendula border-calendula/40',
  wip: 'text-helecho border-corteza',
};
---

<span class:list={['inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-[0.8rem] font-medium', styles[status]]}>
  <span class:list={['size-1.5 rounded-full bg-current', status === 'live' && 'animate-pulse']} aria-hidden="true"></span>
  {t(`status.${status}`)}
</span>

---
import { Image } from 'astro:assets';
import BrowserFrame from './BrowserFrame.astro';
import StatusPill from './StatusPill.astro';
import type { App } from '../lib/apps';
import { getLang, useT, localePath } from '../i18n/utils';

interface Props {
  app: App;
}
const { app } = Astro.props;
const lang = getLang(Astro.url);
const t = useT(lang);
const href = localePath(lang, `/apps/${app.slug}`);
const d = app.data;
---

<article class="grid items-center gap-8 py-12 md:grid-cols-12 md:gap-12 lg:py-16" style={`--hue:${d.hue}`}>
  <a href={href} class="group block md:col-span-7" tabindex="-1" aria-hidden="true">
    <BrowserFrame domain={d.domain} hue={d.hue} class="transition-transform duration-500 ease-salida group-hover:-translate-y-1.5">
      <Image src={d.cover} alt="" widths={[640, 960, 1280]} sizes="(min-width: 48rem) 40rem, 100vw" class="aspect-[16/10] w-full object-cover object-top" />
    </BrowserFrame>
  </a>

  <div class="md:col-span-5">
    <div class="mb-4 flex flex-wrap items-center gap-3 text-sm text-helecho">
      <StatusPill status={d.status} />
      <span>{d.year}</span>
    </div>
    <h3 class="text-[clamp(1.9rem,3.4vw,2.6rem)] leading-[1.05] font-bold tracking-tight">
      <a href={href} class="decoration-(--hue) decoration-2 underline-offset-[6px] hover:underline">{d.title}</a>
    </h3>
    <p class="mt-3 text-lg text-liquen">{d.tagline}</p>
    <p class="mt-3 max-w-[48ch] text-helecho">{d.summary}</p>

    <ul class="mt-5 flex flex-wrap gap-2" aria-label={t('apps.stack')}>
      {d.stack.map((s) => <li class="rounded-md bg-musgo px-2.5 py-1 text-sm text-liquen/90">{s}</li>)}
    </ul>

    <div class="mt-7 flex flex-wrap gap-3">
      <a href={href} class="rounded-lg bg-calendula px-4 py-2.5 font-semibold text-bosque-hondo transition-colors hover:bg-calendula-hondo">
        {t('apps.details')}
      </a>
      {d.url && (
        <a href={d.url} target="_blank" rel="noopener" class="rounded-lg border border-corteza px-4 py-2.5 font-medium transition-colors hover:border-liquen">
          {t('apps.live')}
        </a>
      )}
    </div>
  </div>
</article>

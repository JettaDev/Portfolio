---
import { Image } from 'astro:assets';
import BrowserFrame from './BrowserFrame.astro';
import Status from './Status.astro';
import NewTab from './NewTab.astro';
import type { App } from '../lib/apps';
import { getLang, useT, localePath } from '../i18n/utils';

interface Props {
  app: App;
  /** Imagen a la derecha: las filas alternan el lado para no repetir composición */
  reverse?: boolean;
}
const { app, reverse = false } = Astro.props;
const lang = getLang(Astro.url);
const t = useT(lang);
const href = localePath(lang, `/apps/${app.slug}`);
const d = app.data;
---

<article class="grid items-center gap-10 md:grid-cols-12 md:gap-12" style={`--hue:${d.hue}`}>
  <a href={href} class:list={['group block md:col-span-7', reverse && 'md:order-2']} tabindex="-1" aria-hidden="true">
    <BrowserFrame domain={d.domain} hue={d.hue} name={`ventana-${app.slug}`} class="transition-transform duration-500 ease-salida group-hover:-translate-y-1.5">
      <Image src={d.cover} alt="" widths={[480, 640, 960, 1280]} sizes="(min-width: 48rem) 40rem, 100vw" class="aspect-[16/10] w-full object-cover object-top" />
    </BrowserFrame>
  </a>

  <div class:list={['md:col-span-5', reverse && 'md:order-1']} data-reveal>
    <h3 data-fijo style={`view-transition-name:titulo-${app.slug}`} data-vt={`titulo-${app.slug}`} class="vt-titulo text-[clamp(2.25rem,4vw,3.5rem)] leading-none font-bold tracking-[-0.03em]" translate="no">
      <a href={href} class="decoration-(--hue) decoration-[3px] underline-offset-[8px] hover:underline">{d.title}</a>
    </h3>
    <Status status={d.status} year={d.year} class="mt-4" />
    <p class="mt-6 text-xl text-pretty text-liquen">{d.tagline}</p>
    <p class="mt-3 max-w-[48ch] text-lg text-liquen/80">{d.summary}</p>

    <ul class="mt-6 flex flex-wrap gap-2" aria-label={t('apps.stack')}>
      {d.stack.map((s) => <li class="rounded-md bg-musgo px-2.5 py-1 text-sm text-liquen" translate="no">{s}</li>)}
    </ul>

    <div class="mt-8 flex flex-wrap gap-3">
      <a href={href} class="boton boton-principal">
        {t('apps.details')}<span class="sr-only">: {d.title}</span>
      </a>
      {d.demo && (
        <a href={d.demo} target="_blank" rel="noopener" class="boton boton-secundario">
          {t('apps.demo')}<span class="sr-only">: {d.title}</span><NewTab />
        </a>
      )}
      {d.url && (
        <a href={d.url} target="_blank" rel="noopener" class="boton boton-secundario">
          {t('apps.live')}<span class="sr-only">: {d.title}</span><NewTab />
        </a>
      )}
    </div>
  </div>
</article>

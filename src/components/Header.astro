---
import { getLang, useT, localePath, pagePath, switchLangPath } from '../i18n/utils';
import { languages, type Lang } from '../i18n/ui';
import { site } from '../site';

interface Props {
  /** Transparente mientras está sobre el hero de la portada */
  sobreHero?: boolean;
}
const { sobreHero = false } = Astro.props;
const lang = getLang(Astro.url);
const t = useT(lang);
const other = lang === 'es' ? 'en' : 'es';
const home = localePath(lang, '/');
const actual = Astro.url.pathname.replace(/\/?$/, '/');
const links = [
  { href: pagePath(lang, 'apps'), label: t('nav.apps') },
  { href: pagePath(lang, 'about'), label: t('nav.about') },
  { href: pagePath(lang, 'contact'), label: t('nav.contact') },
].map((l) => ({ ...l, actual: actual === l.href ? ('page' as const) : undefined }));
---

<header class="sticky top-0 z-40 bg-bosque transition-colors duration-300" data-header data-sobre-hero={sobreHero || undefined}>
  <div class="contenedor flex h-16 items-center justify-between gap-4">
    <a href={home} class="group flex items-center gap-2.5 text-lg font-bold tracking-tight" translate="no">
      <svg width="26" height="26" viewBox="0 0 26 26" aria-hidden="true" class="shrink-0">
        <rect x="1" y="5" width="24" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2" />
        <rect x="1" y="3" width="11" height="6" rx="2.5" class="fill-calendula transition-transform duration-300 ease-salida group-hover:translate-x-[12px]" />
      </svg>
      JettaDev
    </a>

    <nav aria-label={t('nav.label')} class="flex items-center gap-1 sm:gap-2">
      <ul class="hidden items-center gap-1 sm:flex">
        {links.map((l) => (
          <li>
            <a href={l.href} aria-current={l.actual} class="rounded-md px-3 py-2 text-helecho transition-colors hover:text-liquen aria-[current]:text-liquen">
              {l.label}
            </a>
          </li>
        ))}
      </ul>
      <a
        href={switchLangPath(Astro.url, other)}
        hreflang={other}
        lang={other}
        title={t('lang.switch')}
        class="hidden rounded-full bg-musgo px-3.5 py-1.5 text-sm font-semibold text-liquen transition-colors hover:bg-musgo-claro sm:inline-block"
      >
        {other.toUpperCase()}<span class="sr-only"> ({languages[other]})</span>
      </a>

      <!-- Menú móvil -->
      <button
        type="button"
        class="boton-menu -mr-2 grid size-11 place-items-center rounded-md text-liquen sm:hidden"
        aria-expanded="false"
        aria-controls="menu-movil"
        aria-label={t('nav.menu')}
        data-menu-toggle
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path class="raya raya-1" d="M4 8h16" />
          <path class="raya raya-2" d="M4 16h16" />
        </svg>
      </button>
    </nav>
  </div>

</header>

<div id="menu-movil" class="menu-movil fixed z-30 inset-x-0 top-16 bottom-0 flex flex-col bg-bosque sm:hidden" data-open="false" inert>
  <nav aria-label={t('nav.menu')}>
  <ul class="contenedor flex flex-col pt-6">
    {links.map((l, i) => (
      <li class="enlace" style={`--i:${i}`}>
        <a href={l.href} aria-current={l.actual} class="block py-4 text-[2.5rem] leading-none font-bold tracking-tight" data-menu-link>
          {l.label}
        </a>
      </li>
    ))}
  </ul>
  </nav>

  <div class="contenedor mt-auto flex flex-col gap-6 pb-10">
    <div>
      <p class="text-sm text-helecho">{t('nav.language')}</p>
      <ul class="mt-2 flex gap-2">
        {(Object.keys(languages) as Lang[]).map((l) => (
          <li>
            <a
              href={switchLangPath(Astro.url, l)}
              hreflang={l}
              lang={l}
              aria-current={l === lang ? 'true' : undefined}
              class="block rounded-full bg-musgo px-4 py-2 font-medium aria-[current]:bg-brote aria-[current]:text-bosque-hondo"
            >
              {languages[l]}
            </a>
          </li>
        ))}
      </ul>
    </div>
    <a href={`mailto:${site.email}`} class="text-lg font-semibold break-all text-calendula">{site.email}</a>
  </div>
</div>

<style>
  /* Solo con JS: sin script no se sabría cuándo se ha dejado atrás el hero */
  :global(.js) header[data-sobre-hero]:not([data-solida]) {
    background-color: transparent;
  }

  .raya {
    transform-origin: 12px 12px;
    transition: transform 0.35s var(--ease-salida);
  }
  [aria-expanded='true'] .raya-1 { transform: translateY(4px) rotate(45deg); }
  [aria-expanded='true'] .raya-2 { transform: translateY(-4px) rotate(-45deg); }

  .menu-movil {
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition: opacity 0.25s, transform 0.35s var(--ease-salida), visibility 0s 0.35s;
  }
  .menu-movil[data-open='true'] {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }
  .menu-movil .enlace {
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.3s, transform 0.45s var(--ease-salida);
  }
  .menu-movil[data-open='true'] .enlace {
    opacity: 1;
    transform: none;
    transition-delay: calc(0.05s + var(--i) * 0.05s);
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('menu-movil');

  // Sobre el hero la cabecera es transparente solo arriba del todo: en cuanto se baja, los textos
  // del hero pasarían por debajo del menú. Con el menú abierto también recupera el fondo.
  let arriba = !!header?.hasAttribute('data-sobre-hero') && scrollY < 4;
  const solida = () => header?.toggleAttribute('data-solida', !arriba || header.hasAttribute('data-menu-abierto'));
  if (header?.hasAttribute('data-sobre-hero')) {
    addEventListener('scroll', () => {
      const ahora = scrollY < 4;
      if (ahora !== arriba) {
        arriba = ahora;
        solida();
      }
    }, { passive: true });
    solida();
  }

  if (header && toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.dataset.open = String(open);
      menu.inert = !open;
      header.toggleAttribute('data-menu-abierto', open);
      solida();
      // El menú tapa la página: lo de detrás no debe recibir el foco ni leerse mientras está abierto.
      document.querySelectorAll<HTMLElement>('body > :not(header):not(#menu-movil):not(script)').forEach((el) => (el.inert = open));
      document.documentElement.style.overflow = open ? 'hidden' : '';
    };

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    menu.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.dataset.open === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
    // Si se pasa a escritorio con el menú abierto, cerrarlo
    matchMedia('(min-width: 40rem)').addEventListener('change', (e) => e.matches && setOpen(false));
  }
</script>

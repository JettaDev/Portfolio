---
import { Image } from 'astro:assets';
import type { App } from '../lib/apps';
import { getLang, useT, localePath } from '../i18n/utils';

interface Props {
  apps: App[];
}
const { apps } = Astro.props;
const lang = getLang(Astro.url);
const t = useT(lang);
const first = apps[0];
---

<div class="hero-browser relative" data-hero-browser>
  <div class="ventana overflow-hidden rounded-ventana bg-bosque-hondo">
    <!-- Pestañas = apps -->
    <div class="flex items-end gap-1 overflow-x-auto px-3 pt-3 [scrollbar-width:none]" role="tablist" aria-label={t('hero.tabsLabel')}>
      {apps.map((app, i) => (
        <button
          type="button"
          role="tab"
          id={`tab-${app.slug}`}
          aria-controls={`panel-${app.slug}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          data-domain={app.data.domain}
          data-hue={app.data.hue}
          style={`--hue:${app.data.hue}; --i:${i}`}
          class="pestana group relative flex min-w-0 shrink-0 items-center gap-2 rounded-t-lg px-4 py-2.5 text-sm font-medium text-helecho transition-colors hover:text-liquen aria-selected:bg-musgo aria-selected:text-liquen"
          translate="no"
        >
          <span class="size-2 rounded-full bg-(--hue)" aria-hidden="true"></span>
          {app.data.title}
        </button>
      ))}
    </div>

    <div class="bg-musgo px-3 py-2.5">
      <div class="flex items-center gap-2 rounded-md bg-bosque-hondo/70 px-3 py-1.5 text-sm text-helecho">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
        <span data-domain-label translate="no">{first?.data.domain}</span>
      </div>
    </div>

    <!-- Todos los paneles en la misma celda: la ventana mide lo que el más alto -->
    <div class="grid">
      {apps.map((app, i) => (
        <div
          role="tabpanel"
          id={`panel-${app.slug}`}
          aria-labelledby={`tab-${app.slug}`}
          class="panel [grid-area:1/1]"
          data-active={i === 0 ? 'true' : 'false'}
        >
          <a href={localePath(lang, `/apps/${app.slug}`)} class="group block">
            <Image
              src={app.data.cover}
              alt={app.data.coverAlt}
              widths={[480, 640, 960, 1280, 1600]}
              sizes="(min-width: 76rem) 72rem, 100vw"
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : 'auto'}
              class="aspect-[16/10] w-full object-cover object-top"
            />
            <!-- Barra de estado del navegador -->
            <span class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 bg-musgo px-5 py-3.5">
              <span class="text-liquen">{app.data.tagline}</span>
              <span class="font-semibold text-calendula underline-offset-4 group-hover:underline">{t('apps.details')}<span class="sr-only">: {app.data.title}</span></span>
            </span>
          </a>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .panel {
    opacity: 0;
    visibility: hidden;
    transform: scale(1.01);
    transition: opacity 0.35s var(--ease-salida), transform 0.5s var(--ease-salida), visibility 0s 0.35s;
  }
  .panel[data-active='true'] {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }

  /* Único momento orquestado de la página: la ventana se abre y aparecen las pestañas */
  .ventana { animation: abrir 0.9s var(--ease-salida) both 0.15s; }
  .pestana { animation: pestana 0.5s var(--ease-salida) both; animation-delay: calc(0.55s + var(--i) * 0.09s); }
  @keyframes abrir {
    from { opacity: 0; transform: translateY(28px) scale(0.98); }
  }
  @keyframes pestana {
    from { opacity: 0; transform: translateY(8px); }
  }
</style>

<script>
  function initHeroBrowser(root: HTMLElement) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const label = root.querySelector('[data-domain-label]');

    function select(tab: HTMLButtonElement, focus = false) {
      for (const t of tabs) {
        const active = t === tab;
        t.setAttribute('aria-selected', String(active));
        t.tabIndex = active ? 0 : -1;
        const panel = document.getElementById(t.getAttribute('aria-controls')!);
        if (panel) panel.dataset.active = String(active);
      }
      if (label) label.textContent = tab.dataset.domain ?? '';
      if (focus) tab.focus();
    }

    // Al abrir una app desde el hero, es esta ventana (y no la de su fila del listado) la que
    // se transforma en la del detalle.
    const ventana = root.querySelector<HTMLElement>('.ventana')!;
    for (const tab of tabs) {
      const slug = tab.id.replace(/^tab-/, '');
      document.getElementById(`panel-${slug}`)?.addEventListener('click', () => {
        for (const name of [`ventana-${slug}`, `titulo-${slug}`]) {
          document.querySelector<HTMLElement>(`[data-vt="${name}"]`)?.style.setProperty('view-transition-name', 'none');
        }
        ventana.style.viewTransitionName = `ventana-${slug}`;
      });
    }
    // Al volver con el historial (bfcache) cada ventana recupera su nombre.
    addEventListener('pageshow', (e) => {
      if (!e.persisted) return;
      ventana.style.viewTransitionName = '';
      document.querySelectorAll<HTMLElement>('[data-vt]').forEach((el) => el.style.setProperty('view-transition-name', el.dataset.vt!));
    });

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        const map: Record<string, number> = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 };
        if (!(e.key in map)) return;
        e.preventDefault();
        select(tabs[(map[e.key] + tabs.length) % tabs.length], true);
      });
    });
  }

  document.querySelectorAll<HTMLElement>('[data-hero-browser]').forEach(initHeroBrowser);
</script>

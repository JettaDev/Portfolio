---
// Hero de la portada: la ciudad de noche, donde cada ventana encendida es una app.
// El póster (misma escena, misma semilla) se pinta al instante y es el LCP; el motor 3D se
// descarga después y su canvas se funde encima. Sin WebGL, los ventanales del póster son enlaces.
import { getImage } from 'astro:assets';
import posterAncho from '../assets/ciudad/poster-ancho.webp';
import posterAlto from '../assets/ciudad/poster-alto.webp';
import posiciones from '../assets/ciudad/poster.json';
import { ENCUADRES } from '../ciudad/trazado';
import { getCiudad } from '../lib/ciudad';
import { getLang, useT } from '../i18n/utils';

const lang = getLang(Astro.url);
const t = useT(lang);
const ventanas = await getCiudad(lang);

const [ancho, alto] = await Promise.all([
  getImage({ src: posterAncho, widths: [1500, 2200, 3000], format: 'webp' }),
  getImage({ src: posterAlto, widths: [840, 1260, 1680], format: 'webp' }),
]);

// El póster se genera aparte (npm run poster): avisa si ya no cuadra con las apps
const enPoster = (encuadre: 'ancho' | 'alto') => new Map(posiciones[encuadre].ventanas.map((v) => [v.slug, v]));
const posterAnchoPos = enPoster('ancho');
const posterAltoPos = enPoster('alto');
const desfasadas = ventanas.filter((v) => !posterAnchoPos.has(v.slug) || !posterAltoPos.has(v.slug));
const appsEnPoster = posiciones.ancho.ventanas.filter((v) => !v.slug.startsWith('#')).length;
if (desfasadas.length || appsEnPoster !== ventanas.length) {
  console.warn(`[ciudad] El póster no cuadra con las apps (${desfasadas.map((v) => v.slug).join(', ') || 'sobran ventanas'}): ejecuta npm run poster`);
}

// Posición en los dos pósters, como variables CSS (a = ancho, b = alto)
const enLosPosters = (id: string) => {
  const a = posterAnchoPos.get(id);
  const b = posterAltoPos.get(id);
  return a && b ? `--xa:${a.x}; --ya:${a.y}; --xb:${b.x}; --yb:${b.y}` : undefined;
};
---

<section
  class="ciudad relative -mt-16 h-svh min-h-[34rem] overflow-hidden bg-bosque-hondo"
  style={`--aspecto-ancho:${ENCUADRES.ancho.poster}; --aspecto-alto:${ENCUADRES.alto.poster}`}
  aria-labelledby="ciudad-titulo"
  data-ciudad
  data-estado="poster"
>
  <picture>
    <source media={`(min-aspect-ratio: ${ENCUADRES.ancho.desde * 5}/5)`} srcset={ancho.srcSet.attribute} sizes={`${ENCUADRES.ancho.poster * 100}svh`} />
    <img
      src={alto.src}
      srcset={alto.srcSet.attribute}
      sizes={`${ENCUADRES.alto.poster * 100}svh`}
      width={posterAlto.width}
      height={posterAlto.height}
      alt=""
      decoding="async"
      class="absolute inset-0 size-full object-cover"
    />
  </picture>

  <!-- touch-pan-y: el toque en un ventanal funciona y el dedo sigue pudiendo bajar por la página -->
  <canvas class="lienzo absolute inset-0 block size-full touch-pan-y" aria-hidden="true" data-lienzo></canvas>

  <!-- Sin canvas, los ventanales del póster llevan a cada app. Repiten la lista de abajo: fuera del orden de tabulación. -->
  <div class="ventanas-poster absolute inset-0" aria-hidden="true">
    {ventanas.map((v) => (
      <>
        {posterAnchoPos.has(v.slug) && (
          <a href={v.href} tabindex="-1" class="ventana-poster en-ancho" style={`--x:${posterAnchoPos.get(v.slug)!.x}; --y:${posterAnchoPos.get(v.slug)!.y}`}>{v.title}</a>
        )}
        {posterAltoPos.has(v.slug) && (
          <a href={v.href} tabindex="-1" class="ventana-poster en-alto" style={`--x:${posterAltoPos.get(v.slug)!.x}; --y:${posterAltoPos.get(v.slug)!.y}`}>{v.title}</a>
        )}
      </>
    ))}
    {enLosPosters('#sobre-mi') && (
      <a href="#sobre-mi" tabindex="-1" class="ventana-poster en-los-dos" style={enLosPosters('#sobre-mi')}>{t('nav.about')}</a>
    )}
  </div>

  <!-- El solar «Tu proyecto aquí»: el texto del cartel es HTML y lleva a Contacto -->
  {enLosPosters('#contacto') && (
    <a
      href="#contacto"
      class="cartel en-los-dos absolute rounded-md bg-bosque-hondo px-2.5 py-1 text-sm font-semibold whitespace-nowrap text-liquen transition-[background-color,opacity] duration-300 hover:bg-musgo-claro"
      style={enLosPosters('#contacto')}
      data-cartel
    >
      {t('ciudad.solar')}
    </a>
  )}

  <span class="etiqueta pointer-events-none absolute top-0 left-0 rounded-full bg-bosque-hondo px-3 py-1.5 text-sm font-semibold whitespace-nowrap" aria-hidden="true" data-etiqueta data-sobre-mi={t('nav.about')}></span>

  <div class="textos contenedor pointer-events-none relative flex h-full flex-col justify-between pt-24 pb-8 sm:pt-32 sm:pb-12">
    <!-- Titular y entradilla sin animación de entrada: son lo primero que se pinta (LCP) -->
    <div>
      <h1 id="ciudad-titulo" class="max-w-[13em] text-[clamp(2.3rem,6vw,5.25rem)] leading-[0.95] font-bold tracking-[-0.04em] text-balance [font-variation-settings:'opsz'_96]">
        {t('hero.title')}
      </h1>
      <p class="mt-6 max-w-[40ch] text-lg text-pretty text-liquen sm:text-xl">{t('hero.lead')}</p>
    </div>

    <!-- Sin data-reveal: es la entrada accesible a las apps y no debe depender de ningún script -->
    <nav aria-label={t('ciudad.listLabel')}>
      <p class="text-liquen" data-pista data-tactil={t('ciudad.hintTouch')}>{t('ciudad.hint')}</p>
      <ul class="pointer-events-auto mt-3 flex flex-wrap gap-2">
        {ventanas.map((v) => (
          <li>
            <a
              href={v.href}
              class="app flex min-h-11 items-center gap-2 rounded-full bg-bosque-hondo px-4 text-sm font-semibold transition-colors hover:bg-musgo-claro"
              style={`--hue:${v.hue}`}
              data-slug={v.slug}
              translate="no"
            >
              <span class="size-2 rounded-full bg-(--hue)" aria-hidden="true"></span>
              {v.title}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <script type="application/json" data-datos-ciudad set:html={JSON.stringify(ventanas)} />
</section>

<style>
  .ciudad {
    container-type: size;
  }

  .lienzo {
    opacity: 0;
    transition: opacity 0.3s var(--ease-salida);
  }
  [data-estado='vivo'] .lienzo {
    opacity: 1;
  }

  /* Enlaces sobre el póster: misma cuenta que object-fit: cover (el póster se escala a la altura
     y se recorta por los lados), así que la posición horizontal depende de la altura. */
  .ventana-poster {
    position: absolute;
    top: calc(var(--y) * 100%);
    width: 3.5rem;
    height: 2.75rem;
    translate: -50% -50%;
    font-size: 0;
    border-radius: 0.375rem;
  }
  .en-alto {
    left: calc(50% + (var(--x) - 0.5) * 100cqh * var(--aspecto-alto));
  }
  .en-ancho {
    left: calc(50% + (var(--x) - 0.5) * 100cqh * var(--aspecto-ancho));
    display: none;
  }
  @container (min-aspect-ratio: 6 / 5) {
    .en-ancho { display: block; }
    .en-alto { display: none; }
  }
  /* Estudio y cartel: un solo elemento que cambia de sitio según el póster que se ve */
  .en-los-dos {
    left: calc(50% + (var(--xb) - 0.5) * 100cqh * var(--aspecto-alto));
    top: calc(var(--yb) * 100%);
    translate: -50% -50%;
  }
  @container (min-aspect-ratio: 6 / 5) {
    .en-los-dos {
      left: calc(50% + (var(--xa) - 0.5) * 100cqh * var(--aspecto-ancho));
      top: calc(var(--ya) * 100%);
    }
  }
  [data-volando] .cartel {
    opacity: 0;
    pointer-events: none;
  }
  [data-estado='vivo'] .ventanas-poster {
    display: none;
  }

  /* Nombre de la app junto al ventanal con el puntero encima */
  .etiqueta {
    opacity: 0;
    transition: opacity 0.2s;
  }
  .etiqueta[data-visible] {
    opacity: 1;
  }

  .app[data-activa],
  .cartel[data-activa] {
    background: var(--color-musgo-claro);
  }

  /* Durante el vuelo los textos se apartan: si no, quedarían encima de la ventana que se acerca */
  .textos {
    transition: opacity 0.35s var(--ease-salida);
  }
  [data-volando] .textos,
  [data-volando] .etiqueta {
    opacity: 0;
  }
</style>

<script>
  import { detectarNivel } from '../ciudad/rendimiento';
  import type { Ciudad, DatosVentana } from '../ciudad';
  import { centroDe, cubrir, olvidarSalida, recordarSalida, retirar } from '../lib/destello';

  const raiz = document.querySelector<HTMLElement>('[data-ciudad]');
  if (raiz) iniciar(raiz);

  function iniciar(raiz: HTMLElement) {
    const html = document.documentElement;
    const lienzo = raiz.querySelector<HTMLCanvasElement>('[data-lienzo]')!;
    const etiqueta = raiz.querySelector<HTMLElement>('[data-etiqueta]')!;
    const pista = raiz.querySelector<HTMLElement>('[data-pista]')!;
    const enlaces = [...raiz.querySelectorAll<HTMLAnchorElement>('a[data-slug]')];
    const datos: DatosVentana[] = JSON.parse(raiz.querySelector('[data-datos-ciudad]')!.textContent!);
    const cartel = raiz.querySelector<HTMLElement>('[data-cartel]');
    if (cartel) cartel.dataset.posicion = cartel.style.cssText;
    // Lo que dice la etiqueta al señalar algo: el nombre de la app, «Sobre mí» o el texto del cartel
    const titulo = new Map<string, string>([
      ...datos.map((d): [string, string] => [d.slug, d.title]),
      ['#sobre-mi', etiqueta.dataset.sobreMi ?? ''],
      ['#contacto', cartel?.textContent?.trim() ?? ''],
    ]);
    const href = new Map(datos.map((d) => [d.slug, d.href]));

    // Enlaces del prototipo (/#/slug): a la ficha
    const antiguo = location.hash.match(/^#\/([\w-]+)$/)?.[1];
    if (antiguo && href.has(antiguo)) {
      location.replace(href.get(antiguo)!);
      return;
    }

    if (matchMedia('(pointer: coarse)').matches) pista.textContent = pista.dataset.tactil ?? pista.textContent;

    const movimiento = matchMedia('(prefers-reduced-motion: reduce)');
    const reducido = () => movimiento.matches || new URLSearchParams(location.search).has('reducido');
    const nivel = detectarNivel();
    let ciudad: Ciudad | null = null;
    /** App de la que se sale o a la que se vuelve; null con la ciudad en reposo. */
    let enVuelo: string | null = null;

    const marcarVuelo = (fase: 'ida' | 'vuelta' | null) => {
      raiz.toggleAttribute('data-volando', !!fase);
      if (fase) raiz.dataset.vuelo = fase;
      else delete raiz.dataset.vuelo;
    };
    // Las filas del listado recuperan su nombre de view transition
    const restaurarNombres = () =>
      document.querySelectorAll<HTMLElement>('[data-vt]').forEach((el) => el.style.setProperty('view-transition-name', el.dataset.vt!));

    // --- Etiqueta junto al ventanal con el puntero encima ---------------------------------
    let conEtiqueta: string | null = null;
    const colocarEtiqueta = () => {
      if (!conEtiqueta || !ciudad) return;
      const p = ciudad.enPantalla(conEtiqueta);
      if (p) etiqueta.style.transform = `translate(${p.x}px, ${p.y - 26}px) translate(-50%, -100%)`;
      requestAnimationFrame(colocarEtiqueta);
    };
    const prefetch = new Set<string>();
    const precargar = (slug: string) => {
      const url = href.get(slug);
      if (!url || prefetch.has(url)) return;
      prefetch.add(url);
      document.head.append(Object.assign(document.createElement('link'), { rel: 'prefetch', href: url }));
    };
    const alPasar = (id: string | null) => {
      enlaces.forEach((a) => a.toggleAttribute('data-activa', a.dataset.slug === id));
      cartel?.toggleAttribute('data-activa', id === '#contacto');
      // El cartel ya dice lo que es: no hace falta etiqueta encima
      conEtiqueta = id === '#contacto' ? null : id;
      etiqueta.toggleAttribute('data-visible', !!conEtiqueta);
      if (conEtiqueta) {
        etiqueta.textContent = titulo.get(conEtiqueta) ?? '';
        precargar(conEtiqueta);
        colocarEtiqueta();
      }
    };
    // El estudio y el solar llevan a su sección de la portada
    const alPulsar = (id: string) => {
      if (id.startsWith('#')) location.hash = id;
      else entrar(id);
    };

    // --- Ida: vuelo, destello desde el ventanal y navegación real ---------------------------
    const espera = (ms: number) => new Promise((r) => setTimeout(r, ms));
    const entrar = async (slug: string) => {
      if (enVuelo) return;
      const destino = href.get(slug)!;
      // Con la ciudad fuera de la pantalla (foco desde más abajo) no hay vuelo que ver
      if (!ciudad || raiz.getBoundingClientRect().bottom <= 0) {
        location.href = destino;
        return;
      }
      enVuelo = slug;
      precargar(slug);
      alPasar(null);
      marcarVuelo('ida');
      // La fila del listado no debe transformarse en la ficha: la transición sale de la ciudad
      for (const nombre of [`ventana-${slug}`, `titulo-${slug}`]) {
        document.querySelector<HTMLElement>(`[data-vt="${nombre}"]`)?.style.setProperty('view-transition-name', 'none');
      }
      recordarSalida(slug, destino);

      if (reducido()) {
        await cubrir(innerWidth / 2, innerHeight / 2);
      } else {
        // La luz del ventanal llena la pantalla en el último tramo del vuelo
        const vuelo = ciudad.volarA(slug);
        await espera(780);
        const p = ciudad.enPantalla(slug) ?? { x: innerWidth / 2, y: innerHeight / 2 };
        await Promise.all([vuelo, cubrir(p.x, p.y)]);
      }
      location.href = destino;
      // Si la navegación no llega (sin red, bloqueada…), la capa no puede quedarse tapándolo todo
      const rescate = setTimeout(() => {
        olvidarSalida();
        restaurarNombres();
        volver(slug);
      }, 5000);
      addEventListener('pagehide', () => clearTimeout(rescate), { once: true });
    };

    // --- Vuelta: el destello se recoge sobre el ventanal y la cámara vuelve al reposo --------
    const volver = async (slug: string) => {
      esperandoVuelta = false;
      enVuelo = slug;
      marcarVuelo('vuelta');
      if (ciudad && !reducido()) {
        const p = ciudad.enPantalla(slug) ?? { x: innerWidth / 2, y: innerHeight / 2 };
        await retirar(p.x, p.y, 450);
        await ciudad.volverDe(slug);
      } else {
        // Sin vuelo: se recoge sobre el ventanal del póster (o un fundido, con movimiento reducido)
        if (ciudad) await ciudad.volverDe(slug);
        const visible = [...raiz.querySelectorAll(`.ventana-poster[href="${href.get(slug)}"]`)].find((a) => a.getClientRects().length);
        const { x, y } = centroDe(visible ?? null);
        await retirar(x, y);
      }
      enVuelo = null;
      marcarVuelo(null);
      // El foco vuelve al enlace de la app de la que se viene (también si se entró por el canvas)
      enlaces.find((a) => a.dataset.slug === slug)?.focus({ preventScroll: true });
    };

    // 1. Atrás con bfcache: la página vuelve tal cual se dejó (cubierta y con la cámara en el ventanal)
    addEventListener('pageshow', (e) => {
      if (!e.persisted || !enVuelo) return;
      olvidarSalida();
      restaurarNombres();
      volver(enVuelo);
    });

    // 2. Carga normal volviendo de una ficha: el <head> ya ha puesto la capa (data-destello="regreso")
    const regreso = html.dataset.destello === 'regreso' ? html.dataset.regreso : undefined;
    const vuelveDe = regreso && href.has(regreso) ? regreso : undefined;
    let esperandoVuelta = !!vuelveDe;
    if (regreso && !vuelveDe) retirar(innerWidth / 2, innerHeight / 2);

    // --- Lista HTML: el foco y el puntero iluminan su ventanal; Enter o clic hacen el vuelo --
    for (const a of enlaces) {
      const slug = a.dataset.slug!;
      a.addEventListener('pointerenter', () => (ciudad?.resaltar(slug), precargar(slug)));
      a.addEventListener('pointerleave', () => ciudad?.resaltar(null));
      a.addEventListener('focus', () => ciudad?.resaltar(slug));
      a.addEventListener('blur', () => ciudad?.resaltar(null));
      a.addEventListener('click', (e) => {
        // Con modificadores (pestaña nueva…) o sin ciudad, el enlace hace lo suyo
        if (!ciudad || raiz.dataset.estado !== 'vivo' || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        e.preventDefault();
        entrar(slug);
      });
    }

    if (nivel === 'estatico') {
      // Se queda el póster con sus enlaces
      if (vuelveDe) volver(vuelveDe);
      return;
    }

    // --- Scroll: la cámara baja a la calle y la niebla funde la ciudad con la sección siguiente --
    let pendiente = false;
    const alDesplazar = () => {
      if (pendiente) return;
      pendiente = true;
      requestAnimationFrame(() => {
        pendiente = false;
        const r = raiz.getBoundingClientRect();
        const p = Math.min(1, Math.max(0, -r.top / r.height));
        ciudad?.descender(p);
        // El cartel se apaga con la niebla (con movimiento reducido no hay niebla: se queda)
        if (cartel && ciudad && !reducido()) {
          const opacidad = 1 - Math.min(1, Math.max(0, (p - 0.2) / 0.35));
          cartel.style.opacity = String(opacidad);
          // Invisible, tampoco se puede enfocar ni pulsar
          cartel.inert = opacidad < 0.05;
          cartel.style.visibility = opacidad < 0.05 ? 'hidden' : '';
        }
      });
    };
    addEventListener('scroll', alDesplazar, { passive: true });

    // El cartel sigue al solar mientras la ciudad se mueve (parallax, descenso)
    let heroVisible = true;
    new IntersectionObserver(([e]) => {
      heroVisible = e.isIntersecting;
      if (heroVisible) seguirCartel();
    }).observe(raiz);
    let siguiendo = false;
    const seguirCartel = () => {
      if (siguiendo || !cartel) return;
      siguiendo = true;
      const paso = () => {
        const p = ciudad && raiz.dataset.estado === 'vivo' ? ciudad.enPantalla('#contacto') : null;
        if (p) {
          // Solo translate: mover left/top en cada fotograma obligaría a recalcular el layout
          cartel.style.left = '0px';
          cartel.style.top = '0px';
          cartel.style.translate = `calc(${p.x}px - 50%) calc(${p.y}px - 50%)`;
        }
        if (heroVisible && ciudad) requestAnimationFrame(paso);
        else siguiendo = false;
      };
      paso();
    };

    // --- Carga diferida del motor ---------------------------------------------------
    let listo: () => void;
    const primerFrame = new Promise<void>((r) => (listo = r));
    const arrancar = async () => {
      try {
        const { montarCiudad } = await import('../ciudad');
        ciudad = await montarCiudad(lienzo, datos, {
          nivel,
          reducido: reducido(),
          alPrimerFrame: () => {
            raiz.dataset.estado = 'vivo';
            listo();
          },
          alPasar,
          alPulsar,
          alFallar: () => {
            ciudad?.destruir();
            ciudad = null;
            raiz.dataset.estado = 'poster';
            if (cartel) cartel.style.cssText = cartel.dataset.posicion ?? '';
          },
        });
        // Si la vuelta ya ha empezado sin motor (tardaba), la cámara se queda en reposo
        if (vuelveDe && esperandoVuelta) ciudad.situarEn(vuelveDe);
        seguirCartel();
        alDesplazar();
        movimiento.addEventListener('change', () => ciudad?.reducido(reducido()));
      } catch {
        // Sin motor (red caída, WebGL que falla al crear el contexto…): se queda el póster
        raiz.dataset.estado = 'poster';
        listo();
      }
    };

    if (vuelveDe) {
      // Volviendo, la capa tapa la ciudad: el motor arranca ya y, si tarda, se vuelve sin él
      marcarVuelo('vuelta');
      arrancar();
      Promise.race([primerFrame.then(() => espera(320)), espera(4000)]).then(() => volver(vuelveDe));
      return;
    }
    const cuandoLibre = () =>
      'requestIdleCallback' in window ? requestIdleCallback(arrancar, { timeout: 2000 }) : setTimeout(arrancar, 200);
    if (document.readyState === 'complete') cuandoLibre();
    else addEventListener('load', cuandoLibre, { once: true });
  }
</script>

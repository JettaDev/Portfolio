---
// La portada: el barrio de noche, a pantalla completa. Cada ventana encendida es una app; el
// escaparate de la tienda lleva al catálogo, el estudio de encima a Sobre mí y el solar a Contacto.
// El póster (misma escena, misma semilla) se pinta al instante y el motor 3D se descarga después
// y se funde encima. Sin WebGL, los sitios del póster son enlaces.
import { getImage } from 'astro:assets';
import BrowserFrame from './BrowserFrame.astro';
import posterAncho from '../assets/ciudad/poster-ancho.webp';
import posterAlto from '../assets/ciudad/poster-alto.webp';
import posiciones from '../assets/ciudad/poster.json';
import { ENCUADRES } from '../ciudad/trazado';
import { getCiudad } from '../lib/ciudad';
import { getLang, useT, pagePath } from '../i18n/utils';

const lang = getLang(Astro.url);
const t = useT(lang);
const ventanas = await getCiudad(lang);
// Los sitios del barrio que no son apps, con su página
const sitios = { '#apps': pagePath(lang, 'apps'), '#sobre-mi': pagePath(lang, 'about'), '#contacto': pagePath(lang, 'contact') };

const [ancho, alto] = await Promise.all([
  getImage({ src: posterAncho, widths: [1500, 2200, 3000], format: 'webp' }),
  getImage({ src: posterAlto, widths: [840, 1260, 1680], format: 'webp' }),
]);

// El póster se genera aparte (npm run poster): avisa si ya no cuadra con las apps
type Posicion = { slug: string; x: number; y: number; rx?: number; ry?: number };
const enPoster = (encuadre: 'ancho' | 'alto') => new Map((posiciones[encuadre].ventanas as Posicion[]).map((v) => [v.slug, v]));
const posterAnchoPos = enPoster('ancho');
const posterAltoPos = enPoster('alto');
const desfasadas = [...ventanas.map((v) => v.slug), ...Object.keys(sitios)].filter((id) => !posterAnchoPos.has(id) || !posterAltoPos.has(id));
const appsEnPoster = posiciones.ancho.ventanas.filter((v) => !v.slug.startsWith('#')).length;
if (desfasadas.length || appsEnPoster !== ventanas.length) {
  console.warn(`[ciudad] El póster no cuadra con las apps (${desfasadas.join(', ') || 'sobran ventanas'}): ejecuta npm run poster`);
}

// Posición en los dos pósters, como variables CSS (a = ancho, b = alto); `rotulo` usa la del rótulo
const enLosPosters = (id: string, rotulo = false) => {
  const a = posterAnchoPos.get(id);
  const b = posterAltoPos.get(id);
  if (!a || !b) return undefined;
  const [xa, ya, xb, yb] = rotulo ? [a.rx ?? a.x, a.ry ?? a.y, b.rx ?? b.x, b.ry ?? b.y] : [a.x, a.y, b.x, b.y];
  return `--xa:${xa}; --ya:${ya}; --xb:${xb}; --yb:${yb}`;
};
const rotulos = [
  { id: '#apps' as const, texto: t('ciudad.escaparate'), estilo: enLosPosters('#apps', true) },
  { id: '#contacto' as const, texto: t('ciudad.solar'), estilo: enLosPosters('#contacto') },
];
---

<section
  class="ciudad relative -mt-16 h-dvh overflow-hidden bg-bosque-hondo"
  style={`--aspecto-ancho:${ENCUADRES.ancho.poster}; --aspecto-alto:${ENCUADRES.alto.poster}`}
  aria-labelledby="ciudad-titulo"
  data-ciudad
  data-estado="poster"
>
  <picture>
    <source media={`(min-aspect-ratio: ${ENCUADRES.ancho.desde * 5}/5)`} srcset={ancho.srcSet.attribute} sizes={`${ENCUADRES.ancho.poster * 100}svh`} />
    <img
      src={alto.src}
      srcset={alto.srcSet.attribute}
      sizes={`${ENCUADRES.alto.poster * 100}svh`}
      width={posterAlto.width}
      height={posterAlto.height}
      alt=""
      decoding="async"
      class="absolute inset-0 size-full object-cover"
    />
  </picture>

  <!-- touch-pan-y: el toque en un sitio funciona y el navegador no se queda con el gesto -->
  <canvas class="lienzo absolute inset-0 block size-full touch-pan-y" aria-hidden="true" data-lienzo></canvas>

  <!-- Sin canvas, los ventanales, el escaparate y el estudio del póster son enlaces. Repiten los chips y la cabecera: fuera del orden de tabulación. -->
  <div class="ventanas-poster absolute inset-0" aria-hidden="true">
    {ventanas.map((v) => (
      <>
        {posterAnchoPos.has(v.slug) && (
          <a href={v.href} tabindex="-1" class="ventana-poster en-ancho" style={`--x:${posterAnchoPos.get(v.slug)!.x}; --y:${posterAnchoPos.get(v.slug)!.y}`} data-id={v.slug}>{v.title}</a>
        )}
        {posterAltoPos.has(v.slug) && (
          <a href={v.href} tabindex="-1" class="ventana-poster en-alto" style={`--x:${posterAltoPos.get(v.slug)!.x}; --y:${posterAltoPos.get(v.slug)!.y}`} data-id={v.slug}>{v.title}</a>
        )}
      </>
    ))}
    {(['#apps', '#sobre-mi'] as const).map((id) => enLosPosters(id) && (
      <a href={sitios[id]} tabindex="-1" class="ventana-poster sitio en-los-dos" style={enLosPosters(id)} data-id={id}>{id === '#apps' ? t('ciudad.escaparate') : t('nav.about')}</a>
    ))}
  </div>

  <!-- Rótulos del escaparate y del cartel del solar: son HTML (no hay texto 3D) y enlaces reales -->
  {rotulos.map((r) => r.estilo && (
    <a
      href={sitios[r.id]}
      class="rotulo en-los-dos absolute rounded-md bg-bosque-hondo px-2 py-1 text-[0.8125rem] font-semibold sm:px-2.5 sm:text-sm whitespace-nowrap text-liquen transition-[background-color,opacity] duration-300 hover:bg-musgo-claro"
      style={r.estilo}
      data-rotulo={r.id}
    >
      {r.texto}
    </a>
  ))}

  <!-- Marca: hasta aquí, los sitios del póster ya están en el HTML (la portada espera a pintar) -->
  <span id="sitios-poster" hidden></span>

  <span class="etiqueta pointer-events-none absolute top-0 left-0 rounded-full bg-bosque-hondo px-3 py-1.5 text-sm font-semibold whitespace-nowrap" aria-hidden="true" data-etiqueta data-sobre-mi={t('nav.about')} data-miau={t('ciudad.miau')}></span>

  <div class="textos contenedor pointer-events-none relative flex h-full flex-col justify-between pt-20 pb-6 sm:pt-24 sm:pb-10">
    <!-- Titular corto y discreto, sin animación de entrada: es lo primero que se pinta (LCP) -->
    <h1 id="ciudad-titulo" class="max-w-[16ch] text-[clamp(1.35rem,2.4vw,2rem)] leading-[1.1] font-bold tracking-[-0.025em] text-balance">
      {t('hero.title')}
    </h1>

    <!-- Sin data-reveal: es la entrada accesible a las apps y no debe depender de ningún script -->
    <nav aria-label={t('ciudad.listLabel')}>
      <p class="text-liquen" data-pista data-tactil={t('ciudad.hintTouch')}>{t('ciudad.hint')}</p>
      <ul class="pointer-events-auto mt-3 flex flex-wrap gap-2">
        {ventanas.map((v) => (
          <li>
            <a
              href={v.href}
              class="app flex min-h-11 items-center gap-2 rounded-full bg-bosque-hondo px-4 text-sm font-semibold transition-colors hover:bg-musgo-claro"
              style={`--hue:${v.hue}`}
              data-slug={v.slug}
              translate="no"
            >
              <span class="size-2 rounded-full bg-(--hue)" aria-hidden="true"></span>
              {v.title}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <!-- «La ventana sale» (src/lib/salida.ts): el velo oscurece la ciudad alrededor de lo pulsado y
       de estas plantillas sale la ventana que vuela hasta su página -->
  <div class="velo pointer-events-none fixed top-0 left-0 rounded-md" aria-hidden="true" data-velo></div>
  <div hidden aria-hidden="true" data-plantilla-ventana>
    <BrowserFrame domain="" marco decorativa class="w-full">
      <div class="aspect-[16/10] bg-bosque-hondo" data-cuerpo></div>
    </BrowserFrame>
  </div>
  <div hidden aria-hidden="true" data-plantilla-recorte>
    <div class="overflow-hidden rounded-ventana bg-bosque-hondo"><div data-cuerpo></div></div>
  </div>

  <script type="application/json" data-datos-ciudad set:html={JSON.stringify(ventanas)} />
  <script type="application/json" data-sitios-ciudad set:html={JSON.stringify(sitios)} />
</section>

<style>
  .ciudad {
    container-type: size;
  }

  .lienzo {
    opacity: 0;
    transition: opacity 0.3s var(--ease-salida);
  }
  [data-estado='vivo'] .lienzo {
    opacity: 1;
  }

  /* Enlaces sobre el póster: misma cuenta que object-fit: cover (el póster se escala a la altura
     y se recorta por los lados), así que la posición horizontal depende de la altura. */
  .ventana-poster {
    position: absolute;
    top: calc(var(--y) * 100%);
    width: 3.5rem;
    height: 2.75rem;
    translate: -50% -50%;
    font-size: 0;
    border-radius: 0.375rem;
  }
  .ventana-poster.sitio {
    width: 6rem;
  }
  .en-alto {
    left: calc(50% + (var(--x) - 0.5) * 100cqh * var(--aspecto-alto));
  }
  .en-ancho {
    left: calc(50% + (var(--x) - 0.5) * 100cqh * var(--aspecto-ancho));
    display: none;
  }
  @container (min-aspect-ratio: 6 / 5) {
    .en-ancho { display: block; }
    .en-alto { display: none; }
  }
  /* Escaparate, estudio y rótulos: un solo elemento que cambia de sitio según el póster que se ve */
  .en-los-dos {
    left: calc(50% + (var(--xb) - 0.5) * 100cqh * var(--aspecto-alto));
    top: calc(var(--yb) * 100%);
    translate: -50% -50%;
  }
  @container (min-aspect-ratio: 6 / 5) {
    .en-los-dos {
      left: calc(50% + (var(--xa) - 0.5) * 100cqh * var(--aspecto-ancho));
      top: calc(var(--ya) * 100%);
    }
  }
  [data-estado='vivo'] .ventanas-poster {
    display: none;
  }

  /* Nombre de la app (o «Sobre mí») junto a lo que tiene el puntero encima */
  .etiqueta {
    opacity: 0;
    transition: opacity 0.2s;
  }
  .etiqueta[data-visible] {
    opacity: 1;
  }

  .app[data-activa],
  .rotulo[data-activa] {
    background: var(--color-musgo-claro);
  }

  /* Poca altura (móvil apaisado): la manzana ocupa el centro de la pantalla. Sin pista, el titular
     y los chips van juntos y compactos arriba a la izquierda, sobre el cielo, donde no la tapan. */
  @media (max-height: 500px) and (min-aspect-ratio: 6 / 5) {
    .textos {
      justify-content: flex-start;
      gap: 0.625rem;
      padding-top: 4.25rem;
    }
    .textos h1 {
      max-width: 13ch;
      font-size: 1.0625rem;
    }
    [data-pista] {
      display: none;
    }
    .textos ul {
      margin-top: 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.375rem;
    }
    .app {
      min-height: 2.25rem;
      padding-inline: 0.75rem;
      font-size: 0.8125rem;
    }
  }

  /* El velo: un hueco transparente sobre lo pulsado y una sombra enorme que oscurece el resto */
  .velo {
    width: 0;
    height: 0;
    z-index: 30;
    box-shadow: 0 0 0 200vmax color-mix(in oklab, var(--color-bosque-hondo) 82%, transparent);
    opacity: 0;
    transition: opacity 0.6s var(--ease-salida);
  }
  .velo[data-activo] {
    opacity: 1;
  }

  /* Durante el vuelo los textos se apartan: si no, quedarían encima de lo que se acerca */
  .textos {
    transition: opacity 0.35s var(--ease-salida);
  }
  [data-volando] .textos,
  [data-volando] .etiqueta,
  [data-volando] .rotulo {
    opacity: 0;
    pointer-events: none;
  }
</style>

<script>
  import { detectarNivel } from '../ciudad/rendimiento';
  import type { Ciudad, DatosVentana } from '../ciudad';
  import { Velo, crearVentana, finTransicion, olvidarSalida, recordarSalida, type Rect, type Ventana } from '../lib/salida';

  const raiz = document.querySelector<HTMLElement>('[data-ciudad]');
  if (raiz) iniciar(raiz);

  function iniciar(raiz: HTMLElement) {
    const html = document.documentElement;
    const lienzo = raiz.querySelector<HTMLCanvasElement>('[data-lienzo]')!;
    const etiqueta = raiz.querySelector<HTMLElement>('[data-etiqueta]')!;
    const pista = raiz.querySelector<HTMLElement>('[data-pista]')!;
    const chips = [...raiz.querySelectorAll<HTMLAnchorElement>('a[data-slug]')];
    const rotulos = [...raiz.querySelectorAll<HTMLAnchorElement>('a[data-rotulo]')];
    const datos: DatosVentana[] = JSON.parse(raiz.querySelector('[data-datos-ciudad]')!.textContent!);
    const sitios: Record<string, string> = JSON.parse(raiz.querySelector('[data-sitios-ciudad]')!.textContent!);
    rotulos.forEach((r) => (r.dataset.posicion = r.style.cssText));

    /** Adónde lleva cada cosa de la ciudad: la ficha de cada app y la página de cada sitio. */
    const destinos = new Map<string, string>([...datos.map((d): [string, string] => [d.slug, d.href]), ...Object.entries(sitios)]);
    // Lo que dice la etiqueta al señalar algo (el escaparate y el solar ya tienen su rótulo)
    const titulo = new Map<string, string>([...datos.map((d): [string, string] => [d.slug, d.title]), ['#sobre-mi', etiqueta.dataset.sobreMi ?? '']]);
    const conRotulo = (id: string) => rotulos.find((r) => r.dataset.rotulo === id);

    // Enlaces del prototipo (/#/slug): a la ficha
    const antiguo = location.hash.match(/^#\/([\w-]+)$/)?.[1];
    if (antiguo && destinos.has(antiguo)) {
      location.replace(destinos.get(antiguo)!);
      return;
    }

    if (matchMedia('(pointer: coarse)').matches) pista.textContent = pista.dataset.tactil ?? pista.textContent;

    const movimiento = matchMedia('(prefers-reduced-motion: reduce)');
    const reducido = () => movimiento.matches || new URLSearchParams(location.search).has('reducido');
    const nivel = detectarNivel();
    let ciudad: Ciudad | null = null;
    /** Lo que se deja o a lo que se vuelve; null con la ciudad en reposo. */
    let enVuelo: string | null = null;

    const marcarVuelo = (fase: 'ida' | 'vuelta' | null) => {
      raiz.toggleAttribute('data-volando', !!fase);
      if (fase) raiz.dataset.vuelo = fase;
      else delete raiz.dataset.vuelo;
    };

    // --- Etiqueta junto a lo que tiene el puntero encima -------------------------------------
    let conEtiqueta: string | null = null;
    const colocarEtiqueta = () => {
      if (!conEtiqueta || !ciudad) return;
      const p = ciudad.enPantalla(conEtiqueta);
      if (p) etiqueta.style.transform = `translate(${p.x}px, ${p.y - 26}px) translate(-50%, -100%)`;
      requestAnimationFrame(colocarEtiqueta);
    };
    const prefetch = new Set<string>();
    const precargar = (id: string) => {
      const url = destinos.get(id);
      if (!url || prefetch.has(url)) return;
      prefetch.add(url);
      document.head.append(Object.assign(document.createElement('link'), { rel: 'prefetch', href: url }));
      // Y las imágenes de su ficha: la ventana que sale aterriza con la captura ya cargada
      const app = datos.find((d) => d.slug === id) as (DatosVentana & { ficha?: { srcset: string; sizes: string }[] }) | undefined;
      for (const img of app?.ficha ?? []) {
        document.head.append(Object.assign(document.createElement('link'), { rel: 'preload', as: 'image', imageSrcset: img.srcset, imageSizes: img.sizes }));
      }
    };
    const alPasar = (id: string | null) => {
      chips.forEach((a) => a.toggleAttribute('data-activa', a.dataset.slug === id));
      rotulos.forEach((r) => r.toggleAttribute('data-activa', r.dataset.rotulo === id));
      if (id) precargar(id);
      conEtiqueta = id && titulo.has(id) ? id : null;
      etiqueta.toggleAttribute('data-visible', !!conEtiqueta);
      if (conEtiqueta) {
        etiqueta.textContent = titulo.get(conEtiqueta) ?? '';
        colocarEtiqueta();
      }
    };

    // --- Ida: «la ventana sale» --------------------------------------------------------------
    // La ciudad se oscurece alrededor de lo pulsado, la cámara se acerca, la ventana se despega
    // de la fachada (marco, barra y captura) y la view transition la lleva a su sitio en la página
    const velo = new Velo(raiz.querySelector<HTMLElement>('[data-velo]')!);
    const plantillaVentana = raiz.querySelector<HTMLElement>('[data-plantilla-ventana] > *')!;
    const plantillaRecorte = raiz.querySelector<HTMLElement>('[data-plantilla-recorte] > *')!;
    /** Lo que sale de los sitios (escaparate, estudio y solar): un trozo de calle alrededor. */
    const ampliar = (id: string) => (id === '#apps' ? 1.6 : id.startsWith('#') ? 2.8 : undefined);
    /** Rectángulo de lo que sale en la pantalla (el canvas puede no empezar en 0,0). */
    const enVentana = (id: string): Rect | null => {
      const r = ciudad?.rectEnPantalla(id, ampliar(id));
      if (!r) return null;
      const c = lienzo.getBoundingClientRect();
      return { ...r, x: r.x + c.left, y: r.y + c.top };
    };
    /** La ventana que ha salido y espera (al volver con Atrás, sigue ahí). */
    let ventana: Ventana | null = null;

    /** La captura que irá en la ventana: se carga mientras la cámara se acerca. */
    const cargarCaptura = (id: string): Promise<HTMLImageElement | null> => {
      const app = datos.find((d) => d.slug === id);
      if (!app) return Promise.resolve(null);
      const img = new Image();
      img.src = app.cover.src;
      img.alt = '';
      img.className = 'size-full object-cover object-top';
      return img.decode().then(
        () => img,
        () => img,
      );
    };

    const sacarVentana = (id: string, r: Rect, captura: HTMLImageElement | null): Ventana => {
      const app = datos.find((d) => d.slug === id) as (DatosVentana & { domain?: string }) | undefined;
      if (app) {
        const v = crearVentana(plantillaVentana, r, (cuerpo) => captura && cuerpo.append(captura));
        v.el.style.setProperty('--hue', app.hue);
        const dominio = v.el.querySelector<HTMLElement>('[data-dominio]');
        if (dominio) dominio.dataset.dominio = app.domain ?? '';
        return v;
      }
      // El escaparate, el estudio o el solar: sale el trozo de ciudad pulsado
      const recorte = ciudad?.recorte(id, ampliar(id));
      return crearVentana(plantillaRecorte, r, (cuerpo) => {
        if (!recorte) return;
        recorte.style.cssText = `display:block;width:${r.ancho}px;height:${r.alto}px`;
        cuerpo.append(recorte);
      });
    };

    const entrar = async (id: string) => {
      if (enVuelo) return;
      const destino = destinos.get(id)!;
      if (!ciudad || reducido()) {
        // Sin motor o con movimiento reducido: a la página sin más
        location.href = destino;
        return;
      }
      enVuelo = id;
      precargar(id);
      alPasar(null);
      marcarVuelo('ida');
      recordarSalida(id, destino);
      velo.oscurecer(() => enVentana(id));
      const [captura] = await Promise.all([cargarCaptura(id), ciudad.acercarA(id)]);
      velo.parar();
      const r = enVentana(id);
      if (r) {
        ventana = sacarVentana(id, r, captura);
        ventana.el.style.viewTransitionName = 'salida';
        // La página se pide mientras la ventana se despega: la espera queda dentro de la animación
        const salida = ventana.salir();
        await new Promise((ok) => setTimeout(ok, 200));
        location.href = destino;
        await salida;
      } else location.href = destino;
      // Si la navegación no llega (sin red, bloqueada…), la ventana vuelve a su sitio
      const rescate = setTimeout(() => {
        olvidarSalida();
        volver(id);
      }, 5000);
      addEventListener('pagehide', () => clearTimeout(rescate), { once: true });
    };

    // --- Vuelta: la ventana de la página regresa a su hueco y la cámara se aleja -------------
    const volver = async (id: string) => {
      enVuelo = id;
      marcarVuelo('vuelta');
      await finTransicion();
      if (ventana) {
        ventana.el.style.viewTransitionName = '';
        const r = enVentana(id);
        if (r && ciudad && !reducido()) await ventana.entrar(r);
        ventana.quitar();
        ventana = null;
      }
      velo.aclarar();
      if (ciudad) await ciudad.volverDe(id, true);
      enVuelo = null;
      marcarVuelo(null);
      // El foco vuelve a lo que llevaba allí: el chip de la app, el rótulo o el enlace de la cabecera
      const enlace = chips.find((a) => a.dataset.slug === id) ?? conRotulo(id) ?? document.querySelector<HTMLAnchorElement>(`header a[href="${destinos.get(id)}"]`);
      enlace?.focus({ preventScroll: true });
    };

    // 1. Atrás con bfcache: la página vuelve tal cual se dejó (la ventana fuera, la cámara cerca)
    addEventListener('pageshow', (e) => {
      if (!e.persisted || !enVuelo) return;
      olvidarSalida();
      volver(enVuelo);
    });

    // 2. Carga normal volviendo de una página de la ciudad: la view transition ya ha llevado su
    //    ventana hasta el sitio del póster (lo prepara el <head>). Solo falta devolver el foco
    const regreso = html.dataset.regreso;
    if (regreso) {
      finTransicion().then(() => {
        delete html.dataset.regreso;
        const enlace = chips.find((a) => a.dataset.slug === regreso) ?? conRotulo(regreso) ?? document.querySelector<HTMLAnchorElement>(`header a[href="${destinos.get(regreso)}"]`);
        enlace?.focus({ preventScroll: true });
      });
    }

    // --- Chips y rótulos: el foco y el puntero iluminan su sitio; Enter o clic hacen el vuelo ---
    for (const a of [...chips, ...rotulos]) {
      const id = a.dataset.slug ?? a.dataset.rotulo!;
      a.addEventListener('pointerenter', () => (ciudad?.resaltar(id), precargar(id)));
      a.addEventListener('pointerleave', () => ciudad?.resaltar(null));
      a.addEventListener('focus', () => ciudad?.resaltar(id));
      a.addEventListener('blur', () => ciudad?.resaltar(null));
      a.addEventListener('click', (e) => {
        // Con modificadores (pestaña nueva…) o sin ciudad, el enlace hace lo suyo
        if (!ciudad || raiz.dataset.estado !== 'vivo' || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        e.preventDefault();
        entrar(id);
      });
    }

    if (nivel === 'estatico') return; // Se queda el póster con sus enlaces

    // Los rótulos siguen a su sitio mientras la cámara se mueve (parallax)
    const seguirRotulos = () => {
      if (ciudad && raiz.dataset.estado === 'vivo' && !enVuelo) {
        for (const r of rotulos) {
          const p = ciudad.enPantalla(r.dataset.rotulo!, 'rotulo');
          if (!p) continue;
          // Solo translate: mover left/top en cada fotograma obligaría a recalcular el layout
          const translate = `calc(${p.x.toFixed(1)}px - 50%) calc(${p.y.toFixed(1)}px - 50%)`;
          if (r.dataset.translate !== translate) {
            r.dataset.translate = translate;
            r.style.left = '0px';
            r.style.top = '0px';
            r.style.translate = translate;
          }
        }
      }
      if (ciudad) requestAnimationFrame(seguirRotulos);
    };

    // --- Carga diferida del motor ---------------------------------------------------
    const arrancar = async () => {
      try {
        const { montarCiudad, climaDelDia } = await import('../ciudad');
        // El tiempo y la hora del visitante (?clima=lluvia|despejado y ?hora=0–24 para probar)
        const params = new URLSearchParams(location.search);
        const climaPedido = params.get('clima');
        const ahora = new Date();
        const horaPedida = Number(params.get('hora'));
        ciudad = await montarCiudad(lienzo, datos, {
          nivel,
          reducido: reducido(),
          clima: climaPedido === 'lluvia' || climaPedido === 'despejado' ? climaPedido : climaDelDia(ahora),
          hora: params.has('hora') && Number.isFinite(horaPedida) ? horaPedida : ahora.getHours() + ahora.getMinutes() / 60,
          alPrimerFrame: () => {
            raiz.dataset.estado = 'vivo';
          },
          alPasar,
          alPulsar: entrar,
          alCuriosidad: (id) => {
            if (id !== '#gato') return;
            // El gato contesta un momento con su etiqueta
            conEtiqueta = '#gato';
            etiqueta.textContent = etiqueta.dataset.miau ?? '';
            etiqueta.toggleAttribute('data-visible', true);
            colocarEtiqueta();
            setTimeout(() => {
              if (conEtiqueta !== '#gato') return;
              conEtiqueta = null;
              etiqueta.removeAttribute('data-visible');
            }, 1400);
          },
          alFallar: () => {
            ciudad?.destruir();
            ciudad = null;
            raiz.dataset.estado = 'poster';
            rotulos.forEach((r) => {
              r.style.cssText = r.dataset.posicion ?? '';
              delete r.dataset.translate;
            });
          },
        });
        seguirRotulos();
        movimiento.addEventListener('change', () => ciudad?.reducido(reducido()));
      } catch {
        // Sin motor (red caída, WebGL que falla al crear el contexto…): se queda el póster
        raiz.dataset.estado = 'poster';
      }
    };

    const cuandoLibre = () =>
      'requestIdleCallback' in window ? requestIdleCallback(arrancar, { timeout: 2000 }) : setTimeout(arrancar, 200);
    if (document.readyState === 'complete') cuandoLibre();
    else addEventListener('load', cuandoLibre, { once: true });
  }
</script>

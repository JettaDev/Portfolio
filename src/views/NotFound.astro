---
import Base from '../layouts/Base.astro';
import { getApps } from '../lib/apps';
import { useT, localePath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const apps = await getApps(lang);
---

<Base title={t('notFound.tab')} noindex>
  <slot name="head" slot="head" />
  <section class="contenedor py-14 lg:py-24">
    <div class="overflow-hidden rounded-ventana border border-corteza bg-bosque-hondo shadow-[0_40px_120px_-40px_rgb(0_0_0/0.85)]">
      <div class="flex items-end gap-1 px-3 pt-3">
        <span class="flex items-center gap-2 rounded-t-lg bg-musgo px-4 py-2.5 text-sm font-medium">
          <span class="size-2 rounded-full bg-calendula" aria-hidden="true"></span>
          {t('notFound.tab')}
        </span>
      </div>
      <div class="bg-musgo px-3 py-2.5">
        <div class="flex items-center gap-2 rounded-md bg-bosque-hondo/70 px-3 py-1.5 text-xs text-helecho">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v6M12 16.5v.5" /></svg>
          <span class="truncate" data-requested-path>404</span>
        </div>
      </div>

      <div class="relative px-6 py-14 sm:px-12 lg:px-16 lg:py-20">
        <span
          class="pointer-events-none absolute -top-4 right-4 text-[clamp(8rem,26vw,20rem)] leading-none font-bold tracking-[-0.05em] text-musgo select-none [font-variation-settings:'opsz'_96] before:content-['404'] sm:right-10"
          aria-hidden="true"></span>

        <div class="relative">
          <h1 class="max-w-[13ch] text-[clamp(2.4rem,6vw,4.2rem)] leading-[0.98] font-bold tracking-[-0.03em] text-balance [font-variation-settings:'opsz'_96]">
            {t('notFound.title')}
          </h1>
          <p class="mt-5 max-w-[46ch] text-lg text-helecho">{t('notFound.lead')}</p>

          <ul class="mt-8 flex flex-wrap gap-2">
            {apps.map((app) => (
              <li>
                <a
                  href={localePath(lang, `/apps/${app.slug}`)}
                  class="flex items-center gap-2 rounded-lg border border-corteza bg-bosque px-4 py-2.5 font-medium transition-colors hover:border-liquen"
                >
                  <span class="size-2 rounded-full" style={`background:${app.data.hue}`} aria-hidden="true"></span>
                  {app.data.title}
                </a>
              </li>
            ))}
          </ul>

          <a
            href={localePath(lang, '/')}
            class="mt-10 inline-block rounded-lg bg-calendula px-5 py-3 font-semibold text-bosque-hondo transition-colors hover:bg-calendula-hondo"
          >
            {t('notFound.home')}
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  const label = document.querySelector('[data-requested-path]');
  if (label) label.textContent = location.host + location.pathname;
</script>

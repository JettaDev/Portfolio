---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import BrowserFrame from '../components/BrowserFrame.astro';
import Status from '../components/Status.astro';
import Gallery from '../components/Gallery.astro';
import NewTab from '../components/NewTab.astro';
import type { App } from '../lib/apps';
import { getLang, useT, localePath, pagePath } from '../i18n/utils';

interface Props {
  app: App;
  next?: App;
}
const { app, next } = Astro.props;
const lang = getLang(Astro.url);
const t = useT(lang);
const d = app.data;
const { Content } = await render(app);

// El edificio de cada app visto a medio vuelo, con el ventanal en el centro (npm run poster)
const fachadas = import.meta.glob<{ default: ImageMetadata }>('../assets/ciudad/fachadas/*.webp', { eager: true });
const fachada = (slug: string) => fachadas[`../assets/ciudad/fachadas/${slug}.webp`]?.default;
const fachadaApp = fachada(app.slug);
const fachadaSiguiente = next && fachada(next.slug);
---

<Base title={d.title} description={d.summary} image={`/og/${lang}/${app.slug}.png`} imageAlt={`${d.title}: ${d.tagline}`}>
  <article style={`--hue:${d.hue}`}>
    <header class="contenedor pt-12 pb-10 lg:pt-20 lg:pb-12">
      <h1 style={`view-transition-name:titulo-${app.slug}`} class="vt-titulo text-[clamp(3rem,10vw,8rem)] leading-[0.9] font-bold tracking-[-0.04em] [font-variation-settings:'opsz'_96]" translate="no">
        {d.title}
      </h1>

      <div class="mt-10 grid gap-10 md:grid-cols-12 md:gap-12" data-reveal>
        <div class="md:col-span-7">
          <p class="max-w-[30ch] text-[clamp(1.4rem,2.4vw,2.1rem)] leading-[1.25] tracking-[-0.01em] text-pretty text-liquen">{d.tagline}</p>
          <Status status={d.status} year={d.year} class="mt-6" />
          <p class="mt-2 text-helecho"><span class="sr-only">{t('apps.stack')}: </span><span translate="no">{d.stack.join(', ')}</span></p>
        </div>
        <div class="flex flex-col gap-4 md:col-span-5 md:items-end">
          <div class="flex flex-wrap gap-3 md:justify-end">
            {d.demo && (
              <a href={d.demo} target="_blank" rel="noopener" class:list={['boton', d.url ? 'boton-secundario' : 'boton-principal md:[.js_&]:boton-secundario']}>
                {t('apps.demo')}<NewTab />
              </a>
            )}
            {d.url && (
              <a href={d.url} target="_blank" rel="noopener" class="boton boton-principal">
                {t('apps.live')}<NewTab />
              </a>
            )}
            {d.repo && (
              <a href={d.repo} target="_blank" rel="noopener" class="boton boton-secundario">
                {t('apps.code')}<NewTab />
              </a>
            )}
          </div>
          {d.demo && <p class="max-w-[36ch] text-helecho md:text-right">{t('apps.demoNote')}</p>}
        </div>
      </div>
    </header>

    <!-- La portada es el último fotograma del vuelo: la fachada del edificio de noche y, donde
         estaba el ventanal, la ventana del navegador con su marco en el color de la app.
         Dentro, la captura o la demo funcionando. -->
    <div class="relative overflow-hidden bg-bosque-hondo pt-10 pb-16 sm:pt-14 sm:pb-24 lg:pt-16 lg:pb-28">
      {fachadaApp && (
        <Image src={fachadaApp} alt="" widths={[800, 1280, 1920]} sizes="100vw" loading="eager" class="absolute inset-0 size-full object-cover" />
      )}
      <div class="contenedor relative">
        <BrowserFrame domain={d.domain} hue={d.hue} name={`ventana-${app.slug}`} marco class="mx-auto max-w-[56rem]">
          {d.demo && (
            <button
              slot="acciones"
              type="button"
              class="hidden shrink-0 rounded-full bg-calendula px-4 py-1.5 text-sm font-semibold text-bosque-hondo transition-[background-color,transform] hover:bg-calendula-hondo active:scale-97 md:[.js_&]:inline-flex"
              data-demo-toggle
              data-demo={d.demo}
              data-label-open={t('apps.tryHere')}
              data-label-close={t('apps.tryHereClose')}
              aria-controls="portada"
              aria-pressed="false"
            >
              {t('apps.tryHere')}
            </button>
          )}
          <div id="portada" class="aspect-[16/10] bg-bosque-hondo" data-destello-destino data-demo-title={`${t('apps.demoFrame')}: ${d.title}`}>
            <Image src={d.cover} alt={d.coverAlt} widths={[800, 1280, 1600]} sizes="(min-width: 58rem) 55rem, 100vw" loading="eager" class="size-full object-cover object-top" />
          </div>
        </BrowserFrame>
      </div>
    </div>

    <div class="contenedor py-16 lg:py-24">
      <div class="prosa mx-auto" data-reveal="cada">
        <Content />
      </div>
    </div>

    <Gallery app={app} />
  </article>

  <nav class="bg-musgo" aria-label={t('apps.more')}>
    <div class="contenedor flex flex-col gap-10 py-16 md:flex-row md:items-end md:justify-between lg:py-24" data-reveal>
      {next && (
        <a href={localePath(lang, `/apps/${next.slug}`)} class="group flex flex-col gap-6 sm:flex-row sm:items-end">
          <!-- Calle abajo: el edificio de la siguiente app, con su ventanal encendido -->
          {fachadaSiguiente && (
            <span class="block w-full max-w-[18rem] overflow-hidden rounded-ventana bg-bosque-hondo sm:w-56">
              <Image src={fachadaSiguiente} alt="" widths={[320, 480, 640]} sizes="(min-width: 40rem) 14rem, 18rem" class="aspect-[16/10] w-full scale-[1.6] object-cover transition-transform duration-500 ease-salida group-hover:scale-[1.8]" />
            </span>
          )}
          <span class="flex items-end gap-6">
            <span>
              <span class="block text-xl text-helecho">{t('apps.next')}</span>
              <span data-vt-siguiente={`titulo-${next.slug}`} class="vt-titulo mt-2 block w-fit text-[clamp(2.25rem,4.5vw,3.5rem)] leading-none font-bold tracking-[-0.03em]" translate="no">{next.data.title}</span>
            </span>
            <svg class="mb-2 shrink-0 text-calendula transition-transform duration-300 ease-salida group-hover:translate-x-2" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </span>
        </a>
      )}
      <a href={pagePath(lang, 'apps')} class="boton boton-secundario self-start md:self-end">{t('apps.back')}</a>
    </div>
  </nav>
</Base>

<script>
  // El título de «Siguiente app» solo se transforma en el de su página si se pulsa este enlace;
  // con un nombre fijo también volaría al volver al listado.
  for (const titulo of document.querySelectorAll<HTMLElement>('[data-vt-siguiente]')) {
    titulo.closest('a')!.addEventListener('click', () => {
      titulo.style.viewTransitionName = titulo.dataset.vtSiguiente!;
    });
  }

  // «Probar aquí»: la ventana de la portada carga la demo real en un iframe, sin salir de la página.
  const toggle = document.querySelector<HTMLButtonElement>('[data-demo-toggle]');
  const portada = document.getElementById('portada');
  if (toggle && portada) {
    const captura = portada.innerHTML;
    toggle.addEventListener('click', () => {
      const abierta = toggle.getAttribute('aria-pressed') === 'true';
      if (abierta) {
        portada.innerHTML = captura;
      } else {
        const iframe = document.createElement('iframe');
        iframe.src = toggle.dataset.demo!;
        iframe.title = portada.dataset.demoTitle!;
        iframe.className = 'size-full';
        portada.replaceChildren(iframe);
        iframe.focus();
      }
      toggle.setAttribute('aria-pressed', String(!abierta));
      toggle.textContent = (abierta ? toggle.dataset.labelOpen : toggle.dataset.labelClose) ?? '';
    });
  }
</script>

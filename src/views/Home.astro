---
import Base from '../layouts/Base.astro';
import Ciudad from '../components/Ciudad.astro';
import AppRow from '../components/AppRow.astro';
import { getApps } from '../lib/apps';
import { getLang, useT } from '../i18n/utils';
import { site } from '../site';

const lang = getLang(Astro.url);
const t = useT(lang);
const apps = await getApps(lang);
---

<Base cabeceraSobreHero>
  <Ciudad />

  <!-- Apps -->
  <section id="apps" class="bg-bosque-hondo py-24 lg:py-36">
    <div class="contenedor">
      <div class="max-w-2xl" data-reveal>
        <h2 class="text-[clamp(2.25rem,4.5vw,3.5rem)] leading-none font-bold tracking-[-0.03em]">{t('apps.title')}</h2>
        <p class="mt-5 text-xl text-liquen">{t('apps.lead')}</p>
      </div>
      <div class="mt-16 flex flex-col gap-24 lg:mt-24 lg:gap-36">
        {apps.map((app, i) => <AppRow app={app} reverse={i % 2 === 1} />)}
      </div>
    </div>
  </section>

  <!-- Sobre mí: el texto a ancho completo y el stack como lista tipográfica -->
  <section id="sobre-mi" class="py-24 lg:py-36">
    <div class="contenedor">
      <div data-reveal>
        <h2 class="text-[clamp(2.25rem,4.5vw,3.5rem)] leading-none font-bold tracking-[-0.03em]">{t('about.title')}</h2>
        <p class="mt-8 max-w-[52ch] text-[clamp(1.4rem,2.4vw,2.1rem)] leading-[1.3] text-pretty tracking-[-0.01em] text-liquen">{t('about.body')}</p>
      </div>
      <div class="mt-16 lg:mt-24" data-reveal>
        <h3 class="text-xl font-semibold text-helecho">{t('about.stack')}</h3>
        <ul class="mt-8 space-y-5">
          {site.stack[lang].map((g) => (
            <li class="max-w-[40ch] text-[clamp(1.4rem,2.4vw,2.1rem)] leading-[1.2] font-semibold tracking-[-0.02em]">
              <span class="font-normal text-helecho">{g.group}</span>{' '}
              <span translate="no">{g.items.join(', ')}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Contacto -->
  <section id="contacto" class="bg-musgo py-24 lg:py-36">
    <div class="contenedor" data-reveal>
      <h2 class="text-[clamp(2.25rem,4.5vw,3.5rem)] leading-none font-bold tracking-[-0.03em]">{t('contact.title')}</h2>
      <p class="mt-5 max-w-[50ch] text-xl text-liquen">{t('contact.lead')}</p>
      <a
        href={`mailto:${site.email}`}
        class="mt-12 inline-block text-[clamp(1.6rem,5.5vw,4.5rem)] leading-none font-bold tracking-[-0.03em] break-all text-calendula underline decoration-calendula/30 decoration-[3px] underline-offset-[12px] transition-colors hover:decoration-calendula sm:break-normal"
      >
        {site.email}
      </a>
    </div>
  </section>
</Base>

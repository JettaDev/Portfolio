---
// Webs para negocios: el bajo comercial de la ciudad (cuatro escaparates a la izquierda de la tienda)
// lleva aquí. Su imagen es la escena real (npm run poster) y es adonde vuela el bajo al llegar.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PlantillaRow from '../components/PlantillaRow.astro';
import bajo from '../assets/ciudad/sitios/negocios.webp';
import { getPlantillas } from '../lib/plantillas';
import { getLang, useT, pagePath } from '../i18n/utils';

const lang = getLang(Astro.url);
const t = useT(lang);
const plantillas = getPlantillas();
const nota = t('negocios.note');
---

<Base title={t('negocios.title')} description={t('negocios.description')} ventanaDestino>
  <header class="contenedor grid gap-10 pt-12 pb-16 md:grid-cols-12 md:items-center md:gap-12 lg:pt-20 lg:pb-24">
    <div class="md:col-span-6">
      <h1 class="text-[clamp(3rem,8vw,6rem)] leading-[0.9] font-bold tracking-[-0.04em] text-balance [font-variation-settings:'opsz'_96]">{t('negocios.title')}</h1>
      <div data-reveal>
        <p class="mt-10 max-w-[30ch] text-[clamp(1.4rem,2.4vw,2.1rem)] leading-[1.25] tracking-[-0.01em] text-pretty text-liquen">{t('negocios.lead')}</p>
        <p class="mt-6 max-w-[52ch] text-xl text-pretty text-liquen">{t('negocios.body')}</p>
        {nota && <p class="mt-3 text-sm text-helecho">{nota}</p>}
        <div class="mt-10 flex flex-wrap gap-3">
          <a href="#demos" class="boton boton-principal">{t('negocios.demos')}</a>
          <a href={pagePath(lang, 'contact')} class="boton boton-secundario">{t('negocios.contact')}</a>
        </div>
      </div>
    </div>
    <div class="overflow-hidden rounded-ventana bg-bosque-hondo md:col-span-6" id="ventana-destino" data-ventana-destino>
      <Image src={bajo} alt={t('negocios.alt')} widths={[640, 960, 1280, 1600]} sizes="(min-width: 76rem) 36rem, (min-width: 48rem) 50vw, 100vw" loading="eager" class="aspect-[16/10] w-full object-cover" />
    </div>
  </header>

  <section id="demos" class="scroll-mt-20 bg-bosque-hondo py-24 lg:py-36" aria-labelledby="demos-titulo">
    <div class="contenedor">
      <h2 id="demos-titulo" class="sr-only">{t('negocios.demosTitle')}</h2>
      <div class="flex flex-col gap-24 lg:gap-36">
        {plantillas.map((p, i) => <PlantillaRow plantilla={p} reverse={i % 2 === 1} nivel="h3" />)}
      </div>
    </div>
  </section>

  <!-- Los pasos como lista tipográfica, en un campo de color aparte (como el stack de Sobre mí) -->
  <section class="py-24 lg:py-36" aria-labelledby="pasos-titulo">
    <div class="contenedor" data-reveal>
      <h2 id="pasos-titulo" class="text-[clamp(2.25rem,4.5vw,3.5rem)] leading-none font-bold tracking-[-0.03em]">{t('negocios.pasos')}</h2>
      <ol class="mt-12 space-y-5">
        {(['negocios.paso1', 'negocios.paso2', 'negocios.paso3'] as const).map((k) => (
          <li class="max-w-[40ch] text-[clamp(1.4rem,2.4vw,2.1rem)] leading-[1.2] font-semibold tracking-[-0.02em] text-pretty">{t(k)}</li>
        ))}
      </ol>
      <a href={pagePath(lang, 'contact')} class="boton boton-principal mt-12">{t('negocios.contact')}</a>
    </div>
  </section>
</Base>

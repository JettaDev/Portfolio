---
// Layout de Atelier Malva: <head> con SEO y fuentes, aviso de demo, cabecera, pie y barra fija en móvil.
// Lo que no debe faltar está marcado con «contrato».
import Cabeza from '@comun/componentes/Cabeza.astro';
import Demo from '@comun/componentes/Demo.astro';
import BarraAcciones from '@comun/componentes/BarraAcciones.astro';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import config from '../../config.ts';
// Fuentes autoalojadas: solo el subconjunto latino y los pesos que se usan.
import gloock from '@fontsource/gloock/files/gloock-latin-400-normal.woff2?url';
import figtree from '@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url';
import '../styles/global.css';

interface Props {
  titulo?: string;
  descripcion?: string;
  conJsonLd?: boolean;
  /** En las páginas secundarias la cabecera enlaza a las secciones de la portada. */
  portada?: boolean;
}
const { titulo, descripcion, conJsonLd, portada = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const RANGO_LATIN =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const fuentes = `
@font-face{font-family:'Gloock';font-style:normal;font-weight:400;font-display:swap;src:url(${gloock}) format('woff2');unicode-range:${RANGO_LATIN}}
@font-face{font-family:'Figtree Variable';font-style:normal;font-weight:300 900;font-display:swap;src:url(${figtree}) format('woff2-variations');unicode-range:${RANGO_LATIN}}`;
---
<!doctype html>
<html lang="es" data-demo={String(config.demo)}>
  <head>
    <Cabeza config={config} titulo={titulo} descripcion={descripcion} conJsonLd={conJsonLd} /> {/* contrato */}
    <link rel="preload" href={gloock} as="font" type="font/woff2" crossorigin />
    <style set:html={fuentes}></style>
  </head>
  <body class="con-barra">
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <Demo demo={config.demo} nombre={config.negocio.nombre} /> {/* contrato */}
    <Cabecera portada={portada} />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Pie />
    <BarraAcciones config={config} ancla={portada ? '#reserva' : `${base}#reserva`} /> {/* contrato */}
  </body>
</html>

---
// El equipo: retratos en arco (foto si la hay; si no, iniciales), especialidad y una frase.
import { iniciales } from '../lib/formato.ts';
import config from '../../config.ts';

const c = config;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
{c.equipo.length > 0 && (
  <section id="equipo" class="equipo seccion" aria-labelledby="t-equipo">
    <div class="envoltura">
      <div class="equipo__cabeza">
        <h2 id="t-equipo" class="titulo-seccion">{c.textos.equipoTitulo}</h2>
        <p class="entradilla">{c.textos.equipoEntradilla}</p>
      </div>
      <ul class="equipo__lista" role="list">
        {c.equipo.map((p) => (
          <li class="persona">
            <div class="persona__arco" aria-hidden={p.foto ? undefined : 'true'}>
              {p.foto ? (
                <img src={`${base}${p.foto.replace(/^\//, '')}`} alt={p.nombre} width="300" height="400" loading="lazy" decoding="async" />
              ) : (
                <span>{iniciales(p.nombre)}</span>
              )}
            </div>
            <h3 class="persona__nombre">{p.nombre}</h3>
            <p class="persona__rol">{p.rol}</p>
            {p.bio && <p class="persona__bio">{p.bio}</p>}
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

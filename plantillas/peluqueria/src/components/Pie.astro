---
// Pie: identidad, contacto, redes y enlaces legales (contrato: aviso legal, privacidad y vCard).
import { enlaceTelefono } from '@comun/enlaces.ts';
import config from '../../config.ts';

const c = config;
const d = c.contacto.direccion;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const redes = [
  ['Instagram', c.redes.instagram],
  ['Facebook', c.redes.facebook],
  ['TikTok', c.redes.tiktok],
  ['Reseñas en Google', c.redes.resenas],
].filter((r): r is [string, string] => Boolean(r[1]));
---
<footer class="pie">
  <div class="envoltura pie__rejilla">
    <div class="pie__marca">
      <p class="pie__nombre">{c.negocio.nombre}</p>
      <p class="pie__eslogan">{c.negocio.eslogan}</p>
    </div>
    <address class="pie__contacto">
      <a href={c.contacto.mapsUrl} target="_blank" rel="noopener">{d.calle}<br />{d.codigoPostal} {d.localidad}</a>
      <a href={enlaceTelefono(c.contacto.telefono)}>{c.contacto.telefonoVisible}</a>
      <a href={`mailto:${c.contacto.email}`}>{c.contacto.email}</a>
    </address>
    <ul class="pie__enlaces">
      {redes.map(([n, u]) => <li><a href={u} target="_blank" rel="noopener">{n}</a></li>)}
      <li><a href={`${base}contacto.vcf`} download>{c.textos.contactosGuardar}</a></li>
      <li><a href={`${base}aviso-legal/`}>Aviso legal</a></li>
      <li><a href={`${base}privacidad/`}>Privacidad</a></li>
    </ul>
  </div>
  <div class="envoltura pie__base">
    <p>© {new Date().getFullYear()} {c.legal.titular}</p>
    <p>{c.textos.pieNota}</p>
  </div>
</footer>

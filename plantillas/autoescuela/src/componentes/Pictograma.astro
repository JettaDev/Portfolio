---
// Pictogramas propios en estilo señal (rejilla de 48 × 48, todo en currentColor).
// Se usan solos (placas de permisos) o dentro de <Senal>.
export type NombrePictograma =
  | 'coche' | 'moto' | 'ciclomotor' | 'camion' | 'bici'
  | 'documento' | 'libro' | 'pregunta' | 'volante' | 'carnet'
  | 'glorieta' | 'autovia';

interface Props {
  nombre: NombrePictograma;
  class?: string;
  /** Posición y tamaño cuando va anidado dentro de otro SVG (<Senal>). */
  x?: number;
  y?: number;
  lado?: number;
}
const { nombre, class: clase, x, y, lado } = Astro.props;

// Trazos: «f» = relleno, «t» = trazo (grosor), «e» = relleno con huecos (evenodd).
type Trazo = { f: string } | { t: string; g?: number } | { e: string } | { c: [number, number, number]; g?: number; lleno?: boolean };
const dibujos: Record<NombrePictograma, Trazo[]> = {
  coche: [
    { e: 'M4 31V24.6l6-1.8 6-7.8h14.2l7 7.9 6.8 1.7V31zM18 17.6h4.6v4.7h-7.9zM25.4 17.6h3.6l4.2 4.7h-7.8z' },
    { c: [13, 31.5, 4.6], lleno: true },
    { c: [35, 31.5, 4.6], lleno: true },
  ],
  moto: [
    { c: [11, 31, 6.2], g: 3.4 },
    { c: [37, 31, 6.2], g: 3.4 },
    { t: 'M11 31l8-7h11.5l6.5 7M37 31l-4-13M31 18h6', g: 3.4 },
    { f: 'M14 22.5h7.5l3-3.5h6l3.2 4.2H14z' },
    { f: 'M19.5 24.5h9v6h-9z' },
  ],
  ciclomotor: [
    { c: [12, 33, 5.2], g: 3.4 },
    { c: [36, 33, 5.2], g: 3.4 },
    { f: 'M6 29.5c0-5.4 3.9-8.5 9.5-8.5H20v5.8h9.6L33.4 14h4l-4.6 15.5z' },
    { f: 'M8.5 17.5h11v3h-11z' },
    { t: 'M35.4 14l-1.2-3.4h-4', g: 3 },
  ],
  camion: [
    { f: 'M3 9h28v20.5H3z' },
    { e: 'M33 14h8.2l5 7.6v7.9H33zM35.4 16.4h4.6l3.3 5H35.4z' },
    { f: 'M3 30.2h43v1.6H3z' },
    { c: [11, 33.5, 4.4], lleno: true },
    { c: [38, 33.5, 4.4], lleno: true },
  ],
  bici: [
    { c: [12, 30, 7.4], g: 3 },
    { c: [36, 30, 7.4], g: 3 },
    { t: 'M12 30l7-11h13l4 11M19 19l6 11 7-11M16 15.5h6M32 19l-2-6h4', g: 3 },
  ],
  documento: [
    { t: 'M12 7.5h17l7 7V40.5H12z', g: 3 },
    { t: 'M18 18h12M18 24h12M18 30h7', g: 3 },
    { f: 'M27.5 37.3l12-12 3.2 3.2-12 12-4.4 1.2z' },
  ],
  libro: [
    { t: 'M24 13.5C19 10.5 12.5 10.2 6.5 12v25c6-1.8 12.5-1.4 17.5 1.5 5-2.9 11.5-3.3 17.5-1.5V12c-6-1.8-12.5-1.5-17.5 1.5zM24 13.5v25', g: 3 },
  ],
  pregunta: [
    { t: 'M16.5 17.5a7.5 7.5 0 1 1 11 6.6c-2.4 1.3-3.5 2.6-3.5 5.2v1.8', g: 5 },
    { c: [24, 38, 3.1], lleno: true },
  ],
  volante: [
    { c: [24, 24, 15], g: 4 },
    { c: [24, 24, 4.6], lleno: true },
    { t: 'M9.5 21.5l10.1 1.7M38.5 21.5l-10.1 1.7M24 28.6V39', g: 4 },
  ],
  carnet: [
    { t: 'M6.5 11.5h35v25h-35z', g: 3 },
    { f: 'M11 17h10v13H11z' },
    { t: 'M25 19h12M25 24.5h12M25 30h7', g: 3 },
  ],
  glorieta: [
    { t: 'M21.7 11.2A13 13 0 0 0 11.1 22.2M14 32.4A13 13 0 0 0 28.9 36.1M36.2 28.4A13 13 0 0 0 32 13.8', g: 4.5 },
    { f: 'M10.2 29.1L5.3 20.9L17.1 22.5zM35.4 33.4L30.7 41.8L26.2 30.7zM26.5 9.4L36.1 9.3L28.7 18.8z' },
  ],
  autovia: [
    { f: 'M4 8h40v5H4zM8 13h4v8H8zM36 13h4v8h-4z' },
    { f: 'M15.5 21h5.5L19 44H6zM27 21h5.5L42 44H29z' },
    { t: 'M24 42v-5M24 32v-4M24 24.5v-2', g: 3 },
  ],
};
const trazos = dibujos[nombre];
---
<svg class:list={['pictograma', clase]} viewBox="0 0 48 48" x={x} y={y} width={lado} height={lado} aria-hidden="true" focusable="false">
  {trazos.map((t) =>
    'f' in t ? <path d={t.f} fill="currentColor" />
    : 'e' in t ? <path d={t.e} fill="currentColor" fill-rule="evenodd" />
    : 'c' in t ? (t.lleno
        ? <circle cx={t.c[0]} cy={t.c[1]} r={t.c[2]} fill="currentColor" />
        : <circle cx={t.c[0]} cy={t.c[1]} r={t.c[2]} fill="none" stroke="currentColor" stroke-width={t.g ?? 3} />)
    : <path d={t.t} fill="none" stroke="currentColor" stroke-width={t.g ?? 3} stroke-linecap="round" stroke-linejoin="round" />,
  )}
</svg>

---
import Base from '../layouts/Base.astro';
import TextoLegal from '@comun/componentes/TextoLegal.astro';
import config from '../../config.ts';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base titulo={`Aviso legal · ${config.negocio.nombre}`} conJsonLd={false}>
  <div class="legal envoltura">
    <TextoLegal config={config} tipo="aviso-legal" />
    <p class="legal__volver"><a href={base}>Volver al inicio</a></p>
  </div>
</Base>

---
// El equipo: avatar de iniciales en SVG (o foto si el config la trae), especialidad y una frase.
import config from '../../config.ts';
const c = config;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const iniciales = (nombre: string) =>
  nombre.split(/\s+/).filter(Boolean).slice(0, 2).map((p) => p[0].toUpperCase()).join('');
---
{c.equipo.length > 0 && (
  <section class="equipo envoltura" id="equipo" aria-labelledby="t-equipo">
    <h2 id="t-equipo">{c.textos.equipoTitulo}</h2>
    <ul class="equipo__lista">
      {c.equipo.map((p, n) => (
        <li class="persona">
          {p.foto ? (
            <img class="persona__avatar" src={`${base}${p.foto.replace(/^\//, '')}`} alt="" width="88" height="88" loading="lazy" />
          ) : (
            <svg class="persona__avatar" viewBox="0 0 88 88" aria-hidden="true" focusable="false">
              <circle cx="44" cy="44" r="42" class="persona__fondo" />
              <circle cx="44" cy="44" r="42" class="persona__aro" style={`--giro:${n * 90}deg`} />
              <text x="44" y="45" text-anchor="middle" dominant-baseline="middle">{iniciales(p.nombre)}</text>
            </svg>
          )}
          <h3>{p.nombre}</h3>
          <p class="persona__rol">{p.rol}</p>
          {p.bio && <p class="persona__bio">{p.bio}</p>}
        </li>
      ))}
    </ul>
  </section>
)}

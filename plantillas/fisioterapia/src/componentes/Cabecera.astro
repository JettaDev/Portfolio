---
// Cabecera: logo, estado del horario (enlaza al horario) y, en escritorio, secciones, teléfono y «Pedir cita».
import EstadoHorario from '@comun/componentes/EstadoHorario.astro';
import { enlaceTelefono } from '@comun/enlaces.ts';
import Marca from './Marca.astro';
import config from '../../config.ts';

interface Props { portada?: boolean }
const { portada = false } = Astro.props;
const c = config;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
// En la portada las anclas van solas; en las demás páginas, precedidas de la raíz.
const a = (ancla: string) => (portada ? ancla : `${base}${ancla}`);
const secciones = [
  ['#especialidades', c.catalogo.titulo],
  ['#primera-visita', 'Primera visita'],
  ...(c.equipo.length ? [['#equipo', 'Equipo']] : []),
  ['#horario', 'Horario'],
];
---
<header class="cabecera">
  <div class="cabecera__fila envoltura">
    <a class="logo" href={base} aria-label={`${c.negocio.nombre}, inicio`}>
      <Marca class="logo__marca" />
      <span class="logo__texto">{c.negocio.logo.texto}</span>
    </a>
    <nav class="cabecera__nav" aria-label="Secciones">
      <ul>
        {secciones.map(([href, texto]) => <li><a href={a(href)}>{texto}</a></li>)}
      </ul>
    </nav>
    <a class="cabecera__estado" href={a('#horario')}>
      <EstadoHorario franjas={c.horario.franjas} cierres={c.horario.cierres} porDefecto="Ver horario" />
    </a>
    <a class="cabecera__tel" href={enlaceTelefono(c.contacto.telefono)}>
      <span class="sr">Llamar al </span>{c.contacto.telefonoVisible}
    </a>
    <a class="boton boton--primario cabecera__cita" href={a('#reserva')}>{c.accionPrincipal.texto}</a>
  </div>
</header>

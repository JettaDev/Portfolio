---
// Layout de la clínica: <head> con SEO, fuentes autoalojadas, aviso de demo, cabecera, barra fija y pie.
// Lo marcado con «contrato» no debe faltar (ver plantillas/README.md).
import Cabeza from '@comun/componentes/Cabeza.astro';
import Demo from '@comun/componentes/Demo.astro';
import BarraAcciones from '@comun/componentes/BarraAcciones.astro';
import Cabecera from '../componentes/Cabecera.astro';
import Pie from '../componentes/Pie.astro';
import config from '../../config.ts';
// Solo el subset latino y el eje de peso; la cursiva se descarga solo si se usa.
// Las fuentes «respaldo» imitan el ancho de las reales mientras cargan, para que el texto no salte.
import serif from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url';
import serifCursiva from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-italic.woff2?url';
import sans from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import '../estilos/global.css';

interface Props {
  titulo?: string;
  descripcion?: string;
  conJsonLd?: boolean;
  /** Las páginas secundarias llevan la cabecera sin navegación por secciones. */
  portada?: boolean;
}
const { titulo, descripcion, conJsonLd, portada = false } = Astro.props;

const rango = 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const fuentes = `
@font-face{font-family:'Source Serif 4';font-style:normal;font-display:swap;font-weight:200 900;src:url(${serif}) format('woff2');unicode-range:${rango}}
@font-face{font-family:'Source Serif 4';font-style:italic;font-display:swap;font-weight:200 900;src:url(${serifCursiva}) format('woff2');unicode-range:${rango}}
@font-face{font-family:'Manrope';font-style:normal;font-display:swap;font-weight:200 800;src:url(${sans}) format('woff2');unicode-range:${rango}}
@font-face{font-family:'Manrope respaldo';src:local('Arial'),local('Liberation Sans'),local('Helvetica');size-adjust:103%;ascent-override:103.5%;descent-override:29.1%;line-gap-override:0%}
@font-face{font-family:'Source Serif respaldo';src:local('Times New Roman'),local('Liberation Serif'),local('Times');size-adjust:118%;ascent-override:87.8%;descent-override:28.4%;line-gap-override:0%}`;
---
<!doctype html>
<html lang="es" data-demo={String(config.demo)}>
  <head>
    <Cabeza config={config} titulo={titulo} descripcion={descripcion} conJsonLd={conJsonLd} /> {/* contrato */}
    <link rel="preload" href={serif} as="font" type="font/woff2" crossorigin />
    <style set:html={fuentes}></style>
  </head>
  <body class="con-barra">
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <Demo demo={config.demo} nombre={config.negocio.nombre} /> {/* contrato */}
    <Cabecera portada={portada} />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Pie />
    <BarraAcciones config={config} ancla={portada ? '#reserva' : `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}#reserva`} /> {/* contrato */}
  </body>
</html>
